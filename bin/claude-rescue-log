#!/usr/bin/env bash
# claude-rescue-log — single dispatch point for everything claude-rescue
# does in response to events from Claude Code, tmux, and tmux-resurrect.
#
# Event subcommands (writer):
#   session_start              Read JSON from stdin (Claude SessionStart hook).
#                                Event carries optional `claude_pid` field when
#                                find_my_claude_pid finds an ancestor claude. A
#                                fork guard declines to stamp a source=resume id
#                                that is already live in another pane (see
#                                sid_live_in_other_pane / reconcile_active_session).
#   session_end                Read JSON from stdin (Claude SessionEnd hook).
#                                Event carries optional `claude_pid` (same source).
#   user_prompt_submit         Mark current pane busy (UserPromptSubmit hook) and
#                                reconcile the pane's active session id from stdin
#                                (heals a forked pane to its real id).
#   pre_tool_use               Refresh busy mtime (PreToolUse hook).
#   post_tool_use              Refresh busy mtime (PostToolUse hook).
#   stop                       Clear busy marker (Stop hook) + reconcile active id.
#   title <pane_id> <title>    Schedule a debounced title commit.
#   title-commit <pane_id>     Internal: commit a debounced title if still settled.
#   pane-died <pane_id>        Final flush before tmux reaps a pane.
#   client-detached            Logged at server-wide level (no pane).
#   hibernated <pane_id> <pids> <mode>  Hibernation layer event (soft|hard|skip).
#   unhibernated <pane_id> <mode>       Hibernation layer event.
#
# Resurrect hooks:
#   resurrect-save <state_file>   Write @claude-window-id sidecar (post-save-layout).
#   resurrect-restore             Re-apply @claude-window-id from sidecar (post-restore-all).
#
# Hibernation layer (focus-driven pane suspension):
#   hibernate-arm <pane_id> <pane_pid>   Schedule soft Ctrl+Z after SOFT_DELAY,
#                                         hard `/exit` (with SIGTERM/SIGKILL
#                                         fallback) after HARD_DELAY total.
#   hibernate-resume <pane_id>           Cancel arm + fg the soft-suspended job.
#                                         For mode=hard, leaves the in-flight
#                                         arm subshell alone so its `clr <sid>`
#                                         pre-fill completes.
#   arm-sweep                             Walk every pane and arm any backgrounded
#                                         claude pane that isn't already armed.
#                                         Triggered on client-attached /
#                                         client-session-changed so the user
#                                         doesn't have to physically visit
#                                         each pane to start the countdown.
#
# All output goes to stderr. Stdout is reserved (Claude hooks pipe stdout into context).

set -uo pipefail

# Resolve $0 through any symlinks so we find the real lib/common.sh, regardless
# of how this binary was invoked (direct, via ~/.local/bin/ symlink, etc.).
__script="$0"
while [ -L "$__script" ]; do
  __link="$(readlink "$__script")"
  case "$__link" in
    /*) __script="$__link" ;;
    *)  __script="$(cd "$(dirname "$__script")" && pwd)/$__link" ;;
  esac
done
REPO="$(cd "$(dirname "$__script")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$REPO/lib/common.sh"
# shellcheck source=../lib/session-config.sh
. "$REPO/lib/session-config.sh"

ensure_dirs

DEBOUNCE_SECONDS="${CLAUDE_RESCUE_TITLE_DEBOUNCE:-5}"

# --- Subcommand handlers ----------------------------------------------------

# True (0) if session id $1 is the active session of some pane OTHER than $2.
# The fork guard uses this: a SessionStart(source=resume) whose id is already
# live in another pane is a `--fork-session` adopting the parent's id, not a
# genuine switch to a distinct session.
sid_live_in_other_pane() {
  local sid="$1" self_uuid="$2"
  [ -n "$sid" ] || return 1
  local dir="$CLAUDE_RESCUE_DATA_HOME/active" f
  [ -d "$dir" ] || return 1
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    [ "${f##*/}" = "$self_uuid" ] && continue
    [ "$(head -1 "$f" 2>/dev/null | tr -d '\n')" = "$sid" ] && return 0
  done
  return 1
}

cmd_session_start() {
  local json
  json="$(cat)"
  local session_id cwd source model transcript hook_event
  session_id="$(jq -r '.session_id // empty' <<<"$json")"
  cwd="$(jq -r '.cwd // empty' <<<"$json")"
  source="$(jq -r '.source // empty' <<<"$json")"
  model="$(jq -r '.model // empty' <<<"$json")"
  transcript="$(jq -r '.transcript_path // empty' <<<"$json")"
  hook_event="$(jq -r '.hook_event_name // empty' <<<"$json")"

  if [ -z "$session_id" ]; then
    log_err "session_start: missing session_id in stdin JSON"
    return 0
  fi

  local pane_id="${TMUX_PANE:-}"
  if [ -z "$pane_id" ] || [ -z "${TMUX:-}" ]; then
    log_no_tmux session_start "$session_id" "$cwd" "$source" "$model" "$transcript"
    return 0
  fi

  local window_uuid pane_uuid
  window_uuid="$(ensure_window_uuid "$pane_id")" || {
    log_err "session_start: failed to ensure window uuid for $pane_id"
    return 0
  }
  pane_uuid="$(ensure_pane_uuid "$pane_id")"

  # Duplicate-id guard. Two different situations reach here with an id that is
  # already the active session of ANOTHER pane; stamping it would collide two
  # live panes on one id (breaking the popup, hibernate-arm, and picker).
  #
  # 1. Claude Code <= 2.1.213: a `--fork-session` pane announced itself as
  #    SessionStart(source=resume, .session_id=<parent>) — the parent's id,
  #    because the fork's own id wasn't live yet. This guard is what kept the
  #    fork off the parent's id until reconcile_active_session healed it on the
  #    fork's first message.
  # 2. Any version: the user genuinely resumes one session in a second pane
  #    (`claude --resume <id>` with no --fork-session, while it is open
  #    elsewhere). Same collision, and still worth declining.
  #
  # From 2.1.214 a fork instead reports source=fork carrying its OWN new id
  # (verified empirically on 2.1.257), so forks no longer need the guard at all
  # — they fall straight through and get stamped correctly. The guard stays
  # scoped to source=resume, which now means only case 2 on current versions,
  # and still covers case 1 for anyone on an older release. A stale hit (dead
  # sibling pane) is harmless — reconcile re-adopts on first message.
  local fork_adopt=0
  if [ "$source" = "resume" ] && sid_live_in_other_pane "$session_id" "$pane_uuid"; then
    fork_adopt=1
    log_err "session_start: fork guard — $session_id already live in another pane; not stamping pane $pane_id ($pane_uuid)"
  fi

  # Force-flush any pending title for this pane (so /clear or /compact preserve last task).
  flush_pending_title "$pane_id" "$window_uuid"

  # On /clear or /compact: emit synthetic session_end for the prior session in this pane.
  if [ "$source" = "clear" ] || [ "$source" = "compact" ]; then
    local prior
    prior="$(latest_open_session_in_pane "$window_uuid" "$pane_uuid")"
    if [ -n "$prior" ]; then
      append_event "$window_uuid" "$(jq -nc \
        --arg ts "$(now_iso)" --arg sid "$prior" \
        --arg puuid "$pane_uuid" --arg reason "$source" \
        '{ts:$ts, kind:"session_end", session_id:$sid, pane_uuid:$puuid, reason:$reason}')"
    fi
  fi

  local session_name window_index window_name pane_cwd claude_pid
  IFS=$'\t' read -r session_name window_index window_name pane_cwd \
    < <(tmux_pane_info "$pane_id" || echo $'\t\t\t')
  claude_pid="$(find_my_claude_pid 2>/dev/null || true)"

  # Under the fork guard both the event and the active-file write are skipped, so
  # the parent id never lands on the fork pane (log/meta stay clean).
  if [ "$fork_adopt" -eq 0 ]; then
    append_event "$window_uuid" "$(jq -nc \
      --arg ts "$(now_iso)" --arg sid "$session_id" \
      --arg puuid "$pane_uuid" \
      --arg cwd "${cwd:-$pane_cwd}" --arg src "$source" --arg model "$model" \
      --arg tr "$transcript" --arg sn "$session_name" --arg wn "$window_name" \
      --arg cpid "${claude_pid:-}" \
      '{ts:$ts, kind:"session_start", session_id:$sid, pane_uuid:$puuid,
        cwd:$cwd, source:$src, model:$model, transcript_path:$tr,
        session_name:$sn, window_name:$wn} +
       (if $cpid == "" then {} else {claude_pid:($cpid | tonumber)} end)')"
  fi

  # Update the pane's active session_id. Fires on every source (startup,
  # resume, clear, compact), so an in-claude `/resume` that switches sessions
  # overwrites this with the new sid — claude-rescue-resume reads it next
  # crash-restore in preference to tmux-resurrect's frozen saved `-r <sid>`.
  [ "$fork_adopt" -eq 0 ] && write_active_session "$pane_uuid" "$session_id"

  # claude is alive in this pane — any hibernated marker is now stale. This is
  # the cleanup point for hard-mode markers (focus-in is intentionally a no-op
  # so the marker survives as crash-restore insurance until claude is back).
  local hibernated_file; hibernated_file="$(hibernated_marker_path "$pane_uuid")"
  if [ -f "$hibernated_file" ]; then
    local stale_mode
    stale_mode="$(hibernated_marker_field "$pane_uuid" mode)"
    rm -f "$hibernated_file"
    cmd_unhibernated "$pane_id" "${stale_mode:-hard}" 2>/dev/null || true
  fi

  rebuild_meta "$window_uuid"
}

cmd_session_end() {
  local json
  json="$(cat)"
  local session_id cwd
  session_id="$(jq -r '.session_id // empty' <<<"$json")"
  cwd="$(jq -r '.cwd // empty' <<<"$json")"

  if [ -z "$session_id" ]; then
    log_err "session_end: missing session_id in stdin JSON"
    return 0
  fi

  local pane_id="${TMUX_PANE:-}"
  if [ -z "$pane_id" ] || [ -z "${TMUX:-}" ]; then
    log_no_tmux session_end "$session_id" "$cwd" "" "" ""
    return 0
  fi

  # Reap session-tied state up front, independent of whether the window log
  # is reachable. This MUST happen even when @claude-window-id is missing
  # (e.g. claude crashed before SessionStart fired, or the window option
  # was lost), so orphan arm.pid / active files don't accumulate.
  #   - arm.pid: a pending hibernation timer would otherwise tick down to a
  #     plain zsh and send Ctrl+Z (benign no-op, but wrong). 27 such orphans
  #     observed in production after users dismissed "Resume from summary?".
  #   - active session_id file: gated on absence of a hibernation marker.
  #     The hard-hibernate timer fires `/exit` on claude, which triggers
  #     this SessionEnd handler; if we cleared active/ here, the sid mapping
  #     a user needs to resume would be lost (hibernated/<uuid>.json carries
  #     only pane identity + pids, no sid/cwd). Preserving active/ when a
  #     marker exists is the only mapping that survives until the user
  #     returns. cmd_session_start overwrites active/ with the new sid (and
  #     cleans the marker) the moment claude is back. For non-hibernation
  #     exits (user-initiated /exit, claude crash), clear as before so
  #     orphans don't accumulate; the wrapper still finds prior sessions via
  #     find-sessions (priority 2) keyed by the still-set @claude-pane-id.
  #   - busy marker: safety net if Stop didn't fire (e.g. claude crashed).
  #
  # KEEP @claude-pane-id intact. The hard-hibernation marker is keyed by
  # pane_uuid, and cmd_session_start uses it as the cleanup key when claude
  # returns to this pane (e.g. via the `clr <sid>` pre-fill). Unsetting it
  # here would orphan the marker — ensure_pane_uuid would mint a fresh UUID
  # at next SessionStart and never find the old marker. find-sessions
  # lookups for prior history also need the durable pane identity.
  local pane_uuid
  pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  rm -f "$(arm_pid_path "$pane_id")"
  local hibernated_file; hibernated_file="$(hibernated_marker_path "$pane_uuid")"
  if [ -f "$hibernated_file" ]; then
    log_err "session_end: preserving active/$pane_uuid (hibernation marker present, sid resume path)"
  else
    clear_active_session "$pane_uuid"
  fi
  clear_busy "$pane_uuid"

  local window_uuid
  window_uuid="$(tmux_get_window_uuid "$pane_id")"
  if [ -z "$window_uuid" ]; then
    log_err "session_end: no @claude-window-id on pane $pane_id; cleanup done but skipping event log"
    return 0
  fi

  flush_pending_title "$pane_id" "$window_uuid"

  local claude_pid
  claude_pid="$(find_my_claude_pid 2>/dev/null || true)"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg sid "$session_id" \
    --arg puuid "$pane_uuid" --arg reason "exit" \
    --arg cpid "${claude_pid:-}" \
    '{ts:$ts, kind:"session_end", session_id:$sid, pane_uuid:$puuid, reason:$reason} +
     (if $cpid == "" then {} else {claude_pid:($cpid | tonumber)} end)')"

  rebuild_meta "$window_uuid"
}

# Title debounce/dedup cache paths — keyed by the SANITIZED pane id (title
# events arrive with only the live pane_id in hand; no uuid is guaranteed
# yet). pane_ids RECYCLE across server generations, so this state is
# epoch-guarded: swept wholesale by cmd_resurrect_restore (new server = new
# epoch) and per-pane by cmd_pane_died. Without the sweep, a recycled %N
# inherits the dead pane's title-last dedup memory and its first title event
# gets silently dropped (same bug family as the watcher's ef7f744).
title_cand_path() {
  printf '%s/tmp/title-%s.json' "$CLAUDE_RESCUE_CACHE_HOME" "${1//[^A-Za-z0-9]/_}"
}
title_last_path() {
  printf '%s/tmp/title-last-%s.txt' "$CLAUDE_RESCUE_CACHE_HOME" "${1//[^A-Za-z0-9]/_}"
}

cmd_title() {
  local pane_id="$1" title="$2"
  [ -z "$pane_id" ] && return 0
  [ -z "$title" ] && return 0

  local cand; cand="$(title_cand_path "$pane_id")"
  jq -nc --arg t "$title" --arg ts "$(now_iso)" '{title:$t, ts:$ts}' > "$cand"

  # Schedule a debounced commit. Multiple sleeps may stack; only the one whose
  # candidate is still settled at commit time will write the event.
  ( sleep "$DEBOUNCE_SECONDS"
    "$REPO/bin/claude-rescue-log" title-commit "$pane_id" >/dev/null 2>&1 ) &
  disown 2>/dev/null || true
}

cmd_title_commit() {
  local pane_id="$1"
  local cand last
  cand="$(title_cand_path "$pane_id")"
  last="$(title_last_path "$pane_id")"
  [ -f "$cand" ] || return 0

  local title cand_ts now elapsed
  title="$(jq -r '.title' "$cand")"
  cand_ts="$(jq -r '.ts' "$cand")"
  now="$(now_iso)"

  # Settle check: candidate must be at least DEBOUNCE_SECONDS old.
  elapsed=$(iso_age_seconds "$cand_ts")
  [ "$elapsed" -lt "$DEBOUNCE_SECONDS" ] && return 0

  # Dedup: skip if we already emitted this exact title for this pane.
  if [ -f "$last" ] && [ "$(cat "$last")" = "$title" ]; then
    return 0
  fi

  local window_uuid session_id pane_uuid
  window_uuid="$(tmux_get_window_uuid "$pane_id")"
  [ -z "$window_uuid" ] && return 0
  pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  session_id="$(latest_open_session_in_pane "$window_uuid" "$pane_uuid")"

  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$now" --arg t "$title" \
    --arg puuid "$pane_uuid" --arg sid "${session_id:-}" \
    '{ts:$ts, kind:"title", pane_uuid:$puuid, title:$t} +
     (if $sid == "" then {} else {session_id:$sid} end)')"
  printf '%s' "$title" > "$last"
  rebuild_meta "$window_uuid"
}

# Immediate-commit variant — used by claude-rescue-watcher, whose 1Hz polling
# loop already debounces (a title we observe is by definition stable for at
# least the tick interval). Skips cmd_title's spawn-sleep-commit chain; the
# dedup-against-last check still runs so successive emits of the same value
# are no-ops.
cmd_title_now() {
  local pane_id="$1" title="$2"
  local window_uuid="${3:-}" pane_uuid="${4:-}"
  [ -z "$pane_id" ] && return 0
  [ -z "$title" ] && return 0

  local last; last="$(title_last_path "$pane_id")"
  if [ -f "$last" ] && [ "$(cat "$last" 2>/dev/null)" = "$title" ]; then
    return 0
  fi

  local session_id
  [ -n "$window_uuid" ] || window_uuid="$(tmux_get_window_uuid "$pane_id")"
  [ -z "$window_uuid" ] && return 0
  [ -n "$pane_uuid" ] || pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  session_id="$(latest_open_session_in_pane "$window_uuid" "$pane_uuid")"

  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg t "$title" \
    --arg puuid "$pane_uuid" --arg sid "${session_id:-}" \
    '{ts:$ts, kind:"title", pane_uuid:$puuid, title:$t} +
     (if $sid == "" then {} else {session_id:$sid} end)')"
  mkdir -p "$(dirname "$last")" 2>/dev/null || true
  printf '%s' "$title" > "$last"
  rebuild_meta "$window_uuid"
}

cmd_pane_created() {
  local pane_id="$1"
  local window_uuid="${2:-}" pane_uuid="${3:-}"
  [ -z "$pane_id" ] && return 0
  [ -n "$window_uuid" ] || window_uuid="$(tmux_get_window_uuid "$pane_id")"
  [ -z "$window_uuid" ] && return 0
  [ -n "$pane_uuid" ] || pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg puuid "$pane_uuid" \
    '{ts:$ts, kind:"pane_created", pane_uuid:$puuid}')"
  rebuild_meta "$window_uuid"
}

# Instrumentation only — wired from tmux's alert-activity / alert-bell
# hooks to debug logs (not the per-window event stream). Records each fire
# alongside light context (pane_active, unseen, current command, last-emit
# delta) so we can later decide whether to wire alert-activity into the
# watcher's capture queue. No state mutation, no captures triggered, no
# events emitted into windows/*.jsonl. Pure observation.
__cmd_alert_log() {
  local kind="$1" pane_id="$2"
  [ -z "$pane_id" ] && return 0
  # Fields available from the live pane — cheap to read even at high rate.
  local active unseen cur_cmd
  active="$(tmux display-message -p -t "$pane_id" '#{pane_active}' 2>/dev/null || echo '?')"
  unseen="$(tmux display-message -p -t "$pane_id" '#{pane_unseen_changes}' 2>/dev/null || echo '?')"
  cur_cmd="$(tmux display-message -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null || echo '?')"
  log_debug "$kind" "pane=$pane_id active=$active unseen=$unseen cmd=$cur_cmd"
}
cmd_alert_activity() { __cmd_alert_log "alert-activity" "${1:-}"; }
cmd_alert_bell()     { __cmd_alert_log "alert-bell"     "${1:-}"; }

cmd_pane_died() {
  local pane_id="$1"
  local window_uuid="${2:-}" pane_uuid="${3:-}"
  [ -z "$pane_id" ] && return 0
  # The Watcher Adapter passes identities from its previous snapshot because
  # tmux can no longer resolve options after the pane disappears. Other callers
  # retain the live-pane lookup fallback.
  [ -n "$window_uuid" ] || window_uuid="$(tmux_get_window_uuid "$pane_id")"
  [ -z "$window_uuid" ] && return 0
  [ -n "$pane_uuid" ] || pane_uuid="$(tmux_get_pane_uuid "$pane_id")"

  flush_pending_title "$pane_id" "$window_uuid" "$pane_uuid"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg puuid "$pane_uuid" \
    '{ts:$ts, kind:"pane_died", pane_uuid:$puuid}')"

  # Pane is gone — any hibernated marker for it is orphaned. Best-effort
  # cleanup (only if we resolved a pane_uuid above).
  if [ -n "$pane_uuid" ]; then
    rm -f "$(hibernated_marker_path "$pane_uuid")"
    clear_active_session "$pane_uuid"
  fi
  rm -f "$(arm_pid_path "$pane_id")"
  # Title cache is pane_id-keyed; reap it with the pane so a future pane
  # recycling this id doesn't inherit the dedup memory (and orphans don't
  # accumulate — flush_pending_title above already committed any candidate).
  rm -f "$(title_cand_path "$pane_id")" "$(title_last_path "$pane_id")"

  rebuild_meta "$window_uuid"
}

cmd_client_detached() {
  # Server-wide event; no pane attribution. Best-effort: log for forensic context.
  local marker="$CLAUDE_RESCUE_CACHE_HOME/client-detached.log"
  printf '%s\n' "$(now_iso)" >> "$marker"
}

cmd_hibernated() {
  # Args: $1 = pane_id, $2 = pids (or skip reason like "skip:busy"),
  #       $3 = mode ("soft"|"hard"|"skip")
  local pane_id="$1" pids="${2:-}" mode="${3:-soft}"
  [ -z "$pane_id" ] && return 0
  local window_uuid session_id pane_uuid
  window_uuid="$(tmux_get_window_uuid "$pane_id")" || true
  [ -z "$window_uuid" ] && return 0
  pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  session_id="$(latest_open_session_in_pane "$window_uuid" "$pane_uuid")"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg puuid "$pane_uuid" \
    --arg pids "$pids" --arg sid "${session_id:-}" --arg mode "$mode" \
    '{ts:$ts, kind:"hibernated", pane_uuid:$puuid, pids:$pids, mode:$mode} +
     (if $sid == "" then {} else {session_id:$sid} end)')"
}

cmd_unhibernated() {
  # Args: $1 = pane_id, $2 = mode previously hibernated as ("soft"|"hard")
  local pane_id="$1" mode="${2:-}"
  [ -z "$pane_id" ] && return 0
  local window_uuid session_id pane_uuid
  window_uuid="$(tmux_get_window_uuid "$pane_id")" || true
  [ -z "$window_uuid" ] && return 0
  pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  session_id="$(latest_open_session_in_pane "$window_uuid" "$pane_uuid")"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg puuid "$pane_uuid" \
    --arg sid "${session_id:-}" --arg mode "$mode" \
    '{ts:$ts, kind:"unhibernated", pane_uuid:$puuid, mode:$mode} +
     (if $sid == "" then {} else {session_id:$sid} end)')"
}

# --- Helpers used by handlers -----------------------------------------------

# Returns the session_id of the most recent session_start in this window+pane
# that has not been followed by a session_end (or empty if none).
# Pane is identified by its durable pane_uuid (@claude-pane-id), not the
# transient tmux %N pane_id.
latest_open_session_in_pane() {
  # Returns the session_id of the most recent session_start in this window+pane,
  # ordered by event timestamp (NOT insertion order). The previous reduce-based
  # implementation returned the first-seen session_id whose latest event was a
  # start, which misattributed when a pane switched between sessions without an
  # explicit SessionEnd (claude doesn't fire SessionEnd when the user resumes
  # a different session — only on /clear, /compact, and exit).
  local window_uuid="$1" pane_uuid="$2"
  local log="$CLAUDE_RESCUE_DATA_HOME/windows/$window_uuid.jsonl"
  [ -f "$log" ] || return 0
  [ -z "$pane_uuid" ] && return 0
  jq -rs --arg puuid "$pane_uuid" '
    [.[] | select(.pane_uuid == $puuid and (.kind | startswith("session_start")))]
    | sort_by(.ts) | last | .session_id // empty
  ' "$log"
}

flush_pending_title() {
  local pane_id="$1" window_uuid="$2" pane_uuid="${3:-}"
  local cand last
  cand="$(title_cand_path "$pane_id")"
  last="$(title_last_path "$pane_id")"
  [ -f "$cand" ] || return 0
  local title
  title="$(jq -r '.title' "$cand")"
  if [ -f "$last" ] && [ "$(cat "$last")" = "$title" ]; then
    return 0
  fi
  local session_id
  [ -n "$pane_uuid" ] || pane_uuid="$(tmux_get_pane_uuid "$pane_id")"
  session_id="$(latest_open_session_in_pane "$window_uuid" "$pane_uuid")"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg t "$title" \
    --arg puuid "$pane_uuid" --arg sid "${session_id:-}" \
    '{ts:$ts, kind:"title", pane_uuid:$puuid, title:$t, forced:true} +
     (if $sid == "" then {} else {session_id:$sid} end)')"
  printf '%s' "$title" > "$last"
}

iso_age_seconds() {
  local ts="$1"
  local then now
  then="$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" "+%s" 2>/dev/null)" || { echo 0; return; }
  now="$(date -u +%s)"
  echo $((now - then))
}

log_no_tmux() {
  local kind="$1" sid="$2" cwd="$3" source="$4" model="$5" transcript="$6"
  local host bucket
  host="$(hostname -s)"
  bucket="$CLAUDE_RESCUE_DATA_HOME/no-tmux/${host}__$(printf '%s' "$cwd" | shasum | cut -c1-12).jsonl"
  printf '%s\n' "$(jq -nc \
    --arg ts "$(now_iso)" --arg k "$kind" --arg sid "$sid" --arg cwd "$cwd" \
    --arg src "$source" --arg model "$model" --arg tr "$transcript" \
    '{ts:$ts, kind:$k, session_id:$sid, cwd:$cwd, source:$src, model:$model, transcript_path:$tr}')" \
    >> "$bucket"
}

# --- Resurrect hooks (post-save-layout / post-restore-all) ------------------

cmd_resurrect_save() {
  # Hooked into tmux-resurrect via @resurrect-hook-post-save-layout.
  # Two jobs:
  #   1. Write the @claude-window-id / @claude-pane-id sidecar so UUIDs survive
  #      a kill-server cycle (replayed by cmd_resurrect_restore).
  #   2. Diff this snapshot against the previous one and emit title transitions
  #      + pane_died events. This is the same logic as bin/claude-rescue-backfill;
  #      backfill runs it over a chain of historical snapshots, live runs it
  #      incrementally over one new (prev → current) pair.
  #
  # The resurrect snapshot files are the single source of truth — they're
  # exactly what would be replayed on restore, so what we log matches what
  # the user actually has in saved state. No filesystem dedupe state (no
  # `*.last` files), no race-prone read-then-write across hook firings.
  local state_file="${1:-}"
  [ -n "$state_file" ] || return 0
  [ -f "$state_file" ] || return 0

  # 1. Sidecar — preserves @claude-window-id AND @claude-pane-id across server
  # restarts. Format is type-prefixed TSV; restore reads each line by leading
  # column. Legacy 4-column rows (no leading type) are still understood by
  # the restore handler for backwards compat.
  #   window<TAB>session<TAB>window_idx<TAB>window_name<TAB>uuid
  #   pane<TAB>session<TAB>window_idx<TAB>pane_idx<TAB>pane_uuid
  #
  # Sentinel-encode internal empties (`-` for any empty field) so bash's
  # `IFS=$'\t' read` at restore time doesn't collapse them. Tab is whitespace
  # in IFS, and consecutive whitespace IFS chars get coalesced — without this,
  # an empty window_name silently shifts subsequent fields, making the uuid
  # read as col4 and col5 empty. Same trick as state-dump.sh's restore-plan
  # synth.
  local sidecar="${state_file%.txt}.claude-userops.tsv"
  # OFS="\t" is required: modifying $i triggers awk to reconstruct $0 using
  # OFS, which defaults to space. Without it, the sentinel'd row would have
  # space-separated fields and the restore-side `IFS=$'\t' read` would treat
  # the whole line as col1.
  {
    tmux list-windows -aF $'window\t#{session_name}\t#{window_index}\t#{window_name}\t#{@claude-window-id}' \
      | awk -F'\t' 'BEGIN{OFS="\t"} NF==5 && $5 != "" {
          for (i=1;i<=NF;i++) if ($i=="") $i="-"
          print
        }'
    tmux list-panes -aF $'pane\t#{session_name}\t#{window_index}\t#{pane_index}\t#{@claude-pane-id}' \
      | awk -F'\t' 'BEGIN{OFS="\t"} NF==5 && $5 != "" {
          for (i=1;i<=NF;i++) if ($i=="") $i="-"
          print
        }'
  } > "$sidecar.tmp"
  mv "$sidecar.tmp" "$sidecar"

  # 1b. Hand the completed checkpoint to the State Owner, which serializes
  # indexing, content dedupe, and every retention job — including the two that
  # bound directories this hook used to prune inline. Its client durably spools
  # the checkpoint if the owner is down, so a missed ingest is deferred rather
  # than lost. This is the only archive path: a save hook never writes archive
  # state or prunes a directory directly.
  if ! claude-rescue-state archive-ingest "$state_file" \
    >/dev/null 2>>"$CLAUDE_RESCUE_CACHE_HOME/rescue-log.err"; then
    log_err "resurrect-save: State Owner failed to ingest $state_file"
  fi

  # Title-diff and pane-died inference used to live here (snapshot-vs-prev-
  # snapshot diff against tmux_resurrect_*.txt files). Retired in favor of
  # claude-rescue-watcher's 1Hz polling, which emits these events in real
  # time via cmd_title_now / cmd_pane_died. Keeping the diff here would
  # produce duplicate title events (cmd_title_now's last-value dedup catches
  # them, but it's wasted work) and duplicate pane_died events (no dedup).
}

cmd_resurrect_pre_restore_all() {
  # Hooked into tmux-resurrect via @resurrect-hook-pre-restore-all — the
  # earliest restore hook tmux-resurrect fires. Creates a `.restoring`
  # lock file in the resurrect dir so save-guarded.sh (wired via
  # @resurrect-save-script-path) bails on any save attempt during restore.
  # Without this lock, tmux-continuum's status-bar-interval save can fire
  # mid-restore, capture partial state (panes still in send-keys handoff,
  # claude argv empty), rotate `last` to point at it, and break the
  # @claude-pane-id reapply path in cmd_resurrect_restore — every pane
  # then falls back to saved -r without the sidecar.
  local resurrect_dir
  resurrect_dir="$(tmux show-options -gv @resurrect-dir 2>/dev/null || true)"
  if [ -z "$resurrect_dir" ]; then
    resurrect_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    [ -d "$resurrect_dir" ] || resurrect_dir="$HOME/.tmux/resurrect"
  fi
  mkdir -p "$resurrect_dir" 2>/dev/null || true
  : > "$resurrect_dir/.restoring"
  log_err "resurrect-pre-restore-all: created lock at $resurrect_dir/.restoring"
}

cmd_resurrect_post_restore_all() {
  # Hooked into tmux-resurrect via @resurrect-hook-post-restore-all — fires
  # AFTER all panes have been restored and their send-keys phase is done.
  # Removes the `.restoring` lock so subsequent saves proceed normally.
  local resurrect_dir
  resurrect_dir="$(tmux show-options -gv @resurrect-dir 2>/dev/null || true)"
  if [ -z "$resurrect_dir" ]; then
    resurrect_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    [ -d "$resurrect_dir" ] || resurrect_dir="$HOME/.tmux/resurrect"
  fi
  rm -f "$resurrect_dir/.restoring"
  log_err "resurrect-post-restore-all: removed lock at $resurrect_dir/.restoring"
}

cmd_resurrect_restore() {
  # Hooked into tmux-resurrect via @resurrect-hook-pre-restore-pane-processes.
  # Re-applies @claude-window-id and @claude-pane-id from the sidecar TSV.
  # Accepts two formats:
  #   legacy (4 cols): session<TAB>window_idx<TAB>window_name<TAB>@claude-window-id
  #   current (5 cols, type-prefixed):
  #     window<TAB>session<TAB>window_idx<TAB>window_name<TAB>uuid
  #     pane<TAB>session<TAB>window_idx<TAB>pane_idx<TAB>uuid
  log_err "resurrect-restore: hook fired (TMUX=${TMUX:-<unset>})"
  local resurrect_dir
  resurrect_dir="$(tmux show-options -gv @resurrect-dir 2>/dev/null || true)"
  if [ -z "$resurrect_dir" ]; then
    resurrect_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    [ -d "$resurrect_dir" ] || resurrect_dir="$HOME/.tmux/resurrect"
  fi
  local last_link="$resurrect_dir/last"
  if ! { [ -L "$last_link" ] || [ -f "$last_link" ]; }; then
    log_err "resurrect-restore: no last symlink at $last_link — bailing"
    return 0
  fi
  local state_basename
  state_basename="$(readlink "$last_link" 2>/dev/null || cat "$last_link" 2>/dev/null)"
  if [ -z "$state_basename" ]; then
    log_err "resurrect-restore: last symlink resolves to empty target — bailing"
    return 0
  fi
  local state_file="$resurrect_dir/$state_basename"
  local sidecar="${state_file%.txt}.claude-userops.tsv"
  if [ ! -f "$sidecar" ]; then
    log_err "resurrect-restore: no sidecar at $sidecar — bailing (snapshot=$state_basename)"
    return 0
  fi
  log_err "resurrect-restore: snapshot=$state_basename sidecar_rows=$(wc -l < "$sidecar" | tr -d ' ')"

  local applied_window=0 applied_pane=0 skipped=0
  while IFS=$'\t' read -r col1 col2 col3 col4 col5; do
    # Decode sentinel-encoded empties (`-` → empty). Matches the encoding in
    # cmd_resurrect_save. Only col4 (window_name / pane_idx) and col5 (uuid)
    # are realistically subject to encoding; col1-col3 are never empty for
    # well-formed rows.
    [ "$col4" = "-" ] && col4=""
    [ "$col5" = "-" ] && col5=""
    if [ -z "$col5" ]; then
      # Legacy 4-col line: window only.
      [ -n "$col4" ] || { skipped=$((skipped+1)); continue; }
      tmux set-option -wt "$col1:$col2" @claude-window-id "$col4" 2>/dev/null \
        && applied_window=$((applied_window+1)) \
        || log_err "resurrect-restore: set-option -wt $col1:$col2 @claude-window-id failed"
    else
      case "$col1" in
        window)
          [ -n "$col5" ] || { skipped=$((skipped+1)); continue; }
          tmux set-option -wt "$col2:$col3" @claude-window-id "$col5" 2>/dev/null \
            && applied_window=$((applied_window+1)) \
            || log_err "resurrect-restore: set-option -wt $col2:$col3 @claude-window-id failed"
          ;;
        pane)
          [ -n "$col5" ] || { skipped=$((skipped+1)); continue; }
          tmux set-option -pt "$col2:$col3.$col4" @claude-pane-id "$col5" 2>/dev/null \
            && applied_pane=$((applied_pane+1)) \
            || log_err "resurrect-restore: set-option -pt $col2:$col3.$col4 @claude-pane-id failed"
          ;;
      esac
    fi
  done < "$sidecar"
  log_err "resurrect-restore: applied window=$applied_window pane=$applied_pane skipped=$skipped"

  # === Crash-promote: any pane that was soft-hibernated when the server died
  # is effectively hard-hibernated now (claude died with the crash). Rewrite
  # the marker so hibernate-resume on next focus-in is a no-op (no spurious
  # `fg<Enter>` to a fresh shell with no suspended job).
  local marker current_mode
  for marker in "$CLAUDE_RESCUE_CACHE_HOME"/hibernated/*.json; do
    [ -f "$marker" ] || continue
    current_mode="$(jq -r '.mode // empty' "$marker" 2>/dev/null)"
    if [ "$current_mode" = "soft" ]; then
      jq --arg mode "hard" --arg ts "$(now_iso)" \
         '. + {mode:$mode, hard_ts:$ts, hard_source:"crash-promote"}' \
         "$marker" > "$marker.tmp" && mv "$marker.tmp" "$marker"
    fi
  done
  # Stale arm pid files refer to processes from the dead server.
  rm -f "$CLAUDE_RESCUE_CACHE_HOME"/hibernated/*.arm.pid
  # Title debounce/dedup cache is pane_id-keyed and pane_ids recycle across
  # server generations: a surviving title-last would silently dedup away the
  # first title of an unrelated new pane that reuses the id. New epoch —
  # drop it all (worst case: one duplicate title event per pane).
  rm -f "$CLAUDE_RESCUE_CACHE_HOME"/tmp/title-*

  # Preserve active/<pane_uuid> files across kill-server: they carry the
  # truthful "which session is loaded" set by SessionStart hooks (including
  # in-claude /resume), keyed by the durable pane_uuid that the sidecar
  # reapplies. The wrapper resolves priority-1 from these files, which is
  # the only signal that survives both stale saved -r (set at launch, never
  # updated on in-process /resume) and stale event-log meta (started field
  # frozen at first session_start). On the next SessionStart post-restore,
  # each file is overwritten in place; orphaned entries for vanished
  # pane_uuids are harmless (the wrapper only queries by live pane_uuid).

  # === Post-restore UX: for each pane with a genuine hard-hibernation marker,
  # repaint the hibernation capture (`claude-rescue print` — the pane is reborn
  # blank, and the peek lets the user see what the session was without
  # resuming it), then pre-fill `cd <launch-cwd> && clr <sid>` (no Enter — the
  # user reviews and presses Enter to resume) so a crashed-then-restored
  # session is one keystroke from coming back in the RIGHT directory.
  # `clr -r <sid>` resolves the transcript against the cwd it launches in;
  # restore can drop a pane back in $HOME, so we anchor the cwd explicitly.
  #
  # IDEMPOTENT BY CONSTRUCTION. This hook (pre-restore-pane-processes) fires
  # once per tmux-resurrect restore.sh invocation, but a real boot can trigger
  # restore more than once (continuum's own auto-restore + the restore-wrapper
  # boot path), so this subshell can run concurrently with a twin. A per-pane,
  # per-server-instance claim (atomic mkdir) makes each pane handled exactly
  # once per restore epoch. Without it, a second pass appends its keystrokes
  # onto the first pass's un-terminated pre-fill and a stray Enter executes the
  # garble — the 2026-06-05 incident
  # (docs/operations/rca-2026-06-05-restore-keystroke-race.md).
  #
  # Enter discipline: the original auto `claude-rescue print` was dropped after
  # the incident because its Enter travelled in a SEPARATE burst from the C-u —
  # a twin pass's Enter could land on a buffer holding the first pass's
  # un-terminated pre-fill and execute the concatenation. It is re-introduced
  # below under a hard invariant: ANY Enter-terminated injection must carry its
  # own leading C-u in the SAME send-keys call (tmux processes each send-keys
  # atomically, so nothing can interleave between the wipe and the Enter). Under
  # that rule the only thing an Enter can ever execute is the bare, read-only
  # `claude-rescue print`. The pre-fill itself still never carries Enter and
  # still leads with C-u to wipe any raced/leftover readline input.
  #
  # crash-promote markers (soft-hibernated panes resurrect is auto-resuming via
  # the @resurrect-processes wrapper) are skipped: their pane is racing through
  # shell → claude-rescue-resume → claude and any keystroke corrupts the resume.
  #
  # Done in a backgrounded subshell to avoid blocking the hook; sleeps long
  # enough for resurrect to finish launching pane processes and the shell to
  # render its prompt.
  (
    exec </dev/null >/dev/null 2>>"$CLAUDE_RESCUE_CACHE_HOME/restore-keys.err"
    sleep 5

    # Per-restore-epoch claim dir, scoped by the live tmux server PID so a
    # later reboot (new PID) re-treats each pane. Claims from prior server
    # instances are harmless orphans; sweep them once up front.
    local server_pid claims_dir
    server_pid="$(tmux display-message -p '#{pid}' 2>/dev/null || echo '')"
    claims_dir="$CLAUDE_RESCUE_CACHE_HOME/post-restore-claims"
    mkdir -p "$claims_dir" 2>/dev/null || true
    if [ -n "$server_pid" ]; then
      find "$claims_dir" -mindepth 1 -maxdepth 1 -type d \
        ! -name "${server_pid}__*" -exec rm -rf {} + 2>/dev/null || true
    fi

    local pane_id pane_uuid hib_marker mode hard_source sid
    local claim row launch_cwd prefill cur_cmd
    while IFS=$'\t' read -r pane_id pane_uuid; do
      [ -n "$pane_uuid" ] || continue
      hib_marker="$(hibernated_marker_path "$pane_uuid")"
      [ -f "$hib_marker" ] || continue
      mode="$(hibernated_marker_field "$pane_uuid" mode)"
      [ "$mode" = "hard" ] || continue

      # Discriminate by INTENT, not by current state. A crash-promoted marker
      # means a soft-hibernated pane that resurrect is bringing back via the
      # wrapper — the foreground process is racing through
      # shell → claude-rescue-resume → claude, and pane_current_command could
      # report any of those depending on timing. Sending keys into that pipeline
      # corrupts the resume. Skip; marker will be cleaned up by cmd_session_start
      # when the wrapper-launched claude fires its SessionStart hook.
      hard_source="$(hibernated_marker_field "$pane_uuid" hard_source)"
      if [ "$hard_source" = "crash-promote" ]; then
        continue
      fi

      sid="$(capture_meta_field "$pane_uuid" session_id)"
      [ -n "$sid" ] || continue

      # Idempotency claim: atomic mkdir; the loser of a concurrent race skips.
      # Only the winning pass falls through to send keys. (If we couldn't read
      # a server PID, fall through unguarded rather than never resuming.)
      if [ -n "$server_pid" ]; then
        claim="$claims_dir/${server_pid}__${pane_uuid}"
        if ! mkdir "$claim" 2>/dev/null; then
          # A failed mkdir is only a "skip" if it's EEXIST — i.e. a concurrent
          # pass already claimed this pane. Any OTHER failure (claims_dir
          # unwritable, ENOSPC) must NOT silently skip every pane; fall through
          # and pre-fill, matching the empty-server_pid path. Distinguish by
          # whether the claim dir now actually exists.
          [ -d "$claim" ] && continue
        fi
      fi

      # Resolve the LAUNCH cwd (where `claude -r <sid>` finds the transcript).
      # Pin to THIS session: a pane that hosted more than one session yields
      # multiple find-sessions rows, so match col1 == $sid rather than taking
      # head -1 (which could surface a *different* session's cwd and silently
      # defeat the anchoring for the multi-copy case). col 6 is the
      # jsonl-validated launch cwd; the capture json cwd is last-active and only
      # a fallback. Never emit a `cd` to a dir that no longer exists.
      launch_cwd=""
      row="$("$REPO/bin/claude-rescue" find-sessions --pane-uuid "$pane_uuid" 2>/dev/null \
              | awk -v FS=$'\x1f' -v s="$sid" '$1==s {print; exit}')"
      [ -n "$row" ] && launch_cwd="$(printf '%s' "$row" | awk -v FS=$'\x1f' '{print $6}')"
      [ -z "$launch_cwd" ] && launch_cwd="$(capture_meta_field "$pane_uuid" cwd)"

      # Repaint the capture so the reborn (blank) pane shows what the session
      # looked like — the peek that lets the user decide whether to resume
      # WITHOUT resuming. Safe under the Enter discipline above: C-u + command
      # + Enter travel in ONE atomic send-keys call, so no matter how a twin
      # pass interleaves, this Enter can only execute the bare read-only print
      # (worst unguarded case: the capture paints twice — cosmetic). Also gated
      # on the live foreground being a shell: if the user manually resumed
      # inside our 5s grace, the Enter would otherwise submit the text into
      # claude as a prompt. (Intent gating above decides WHO gets keys; this
      # last-moment state check only shrinks the blast radius of the one
      # Enter we send.)
      cur_cmd="$(tmux display-message -p -t "$pane_id" -F '#{pane_current_command}' 2>/dev/null || echo '')"
      if is_shell_cmd "$cur_cmd"; then
        send_enter_burst "post-restore-print" "$pane_id" "claude-rescue print"
        # Let print finish so the pre-fill lands on a fresh prompt line
        # rather than echoing into the paint.
        sleep 1
      fi

      # Build the pre-fill. %q-quote the cwd: it is typed into a shell, so a dir
      # with a space or shell metachar would otherwise produce a broken `cd`.
      # The sid is a UUID (no special chars), left bare so `clr <sid>` reads
      # naturally. Mirrors the picker's resume_command quoting.
      prefill="clr $sid"
      if [ -n "$launch_cwd" ] && [ -d "$launch_cwd" ]; then
        prefill="$(printf 'cd %q && clr %s' "$launch_cwd" "$sid")"
      fi

      # C-u clears any raced/leftover readline input, then pre-fill (no Enter).
      send_keys_logged "post-restore-clr" "$pane_id" C-u "$prefill"

      # Marker NOT deleted here. The pre-fill is live readline input (not
      # captured by tmux-resurrect), so a second crash before the user presses
      # Enter would lose the recipe. cmd_session_start cleans it up when claude
      # actually restarts; cmd_pane_died handles orphans.
    done < <(tmux list-panes -aF $'#{pane_id}\t#{@claude-pane-id}' 2>/dev/null)
  ) &
  disown 2>/dev/null || true
}

# --- Busy markers (deterministic claude-busy state, hook-driven) ------------
# UserPromptSubmit / PreToolUse / PostToolUse mark the pane busy by touching
# $CACHE/busy/<pane_uuid>. Stop / SessionEnd clear it. cmd_hibernate_arm reads
# this instead of grep'ing the streaming spinner glyph from the pane title —
# deterministic, theme-independent, no race against terminal repaint timing.
#
# The marker is keyed by pane_uuid (durable identity), so resurrect+restore
# across server restarts preserves attribution. Freshness window
# (CLAUDE_RESCUE_BUSY_FRESHNESS, default 1800s) prevents a crashed claude
# that never fired Stop from leaving the pane permanently "busy".

mark_busy() {
  # Args: $1 = pane_uuid, $2 = optional claude_pid
  # Writes a tiny JSON body {claude_pid, ts} into the marker so a stale or
  # confused marker can be traced back to which claude wrote it. The freshness
  # check in is_busy() still uses file mtime — we ignore the JSON body for
  # busy/idle decision; it's purely for troubleshooting.
  local pane_uuid="$1" claude_pid="${2:-}"
  [ -z "$pane_uuid" ] && return 0
  local f="$CLAUDE_RESCUE_CACHE_HOME/busy/$pane_uuid"
  jq -nc --arg ts "$(now_iso)" --arg cpid "$claude_pid" \
    '{ts:$ts} + (if $cpid == "" then {} else {claude_pid:($cpid | tonumber)} end)' \
    > "$f" 2>/dev/null || : > "$f" 2>/dev/null || true
}

clear_busy() {
  local pane_uuid="$1"
  [ -z "$pane_uuid" ] && return 0
  rm -f "$CLAUDE_RESCUE_CACHE_HOME/busy/$pane_uuid"
}

# Returns 0 if pane is busy AND marker mtime is within the freshness window.
is_busy() {
  local pane_uuid="$1"
  [ -z "$pane_uuid" ] && return 1
  local f="$CLAUDE_RESCUE_CACHE_HOME/busy/$pane_uuid"
  [ -f "$f" ] || return 1
  local freshness="${CLAUDE_RESCUE_BUSY_FRESHNESS:-1800}"
  local now mt
  now=$(date +%s)
  mt=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)
  [ "$((now - mt))" -lt "$freshness" ]
}

# Reconcile a pane's active session id from the authoritative stdin .session_id.
#
# A `--fork-session` pane is born via SessionStart(source=resume, .session_id=
# <parent>), so cmd_session_start's fork guard declines to stamp the parent id
# onto it. The fork's REAL id first reaches us HERE, on its own later hooks
# (UserPromptSubmit onward), where claude stamps the live forked id into every
# payload. Trust it: rewrite the active file (what the popup and hibernate-arm
# read, keyed by pane_uuid) and append a synthetic session_start so the picker,
# rebuild_meta, and latest_open_session_in_pane all track the real id.
#
# NEVER emit a session_end for the old id here: rebuild_meta groups by session_id
# across ALL panes in the window, and the old id is usually still live in the
# parent pane — ending it would mark the parent's own session closed.
reconcile_active_session() {
  local pane_id="$1" pane_uuid="$2" json="$3"
  local sid
  sid="$(jq -r '.session_id // empty' <<<"$json" 2>/dev/null || true)"
  [ -z "$sid" ] && return 0

  local current
  current="$(read_active_session "$pane_uuid" 2>/dev/null || true)"
  [ "$sid" = "$current" ] && return 0   # steady state — cheap early return

  # Load-bearing: resolve_pane_session_id (popup) and cmd_hibernate_arm read this.
  write_active_session "$pane_uuid" "$sid"

  local window_uuid
  window_uuid="$(tmux_get_window_uuid "$pane_id" 2>/dev/null || true)"
  [ -z "$window_uuid" ] && return 0     # active healed; no window log to update

  # Mirror cmd_session_start's session_start event. source="reconcile" marks
  # provenance; kind stays "session_start" so rebuild_meta groups it under $sid.
  # UserPromptSubmit/Stop payloads carry .session_id/.cwd/.transcript_path but
  # not .source/.model.
  local cwd transcript session_name window_index window_name pane_cwd claude_pid
  cwd="$(jq -r '.cwd // empty' <<<"$json" 2>/dev/null || true)"
  transcript="$(jq -r '.transcript_path // empty' <<<"$json" 2>/dev/null || true)"
  IFS=$'\t' read -r session_name window_index window_name pane_cwd \
    < <(tmux_pane_info "$pane_id" || echo $'\t\t\t')
  claude_pid="$(find_my_claude_pid 2>/dev/null || true)"
  append_event "$window_uuid" "$(jq -nc \
    --arg ts "$(now_iso)" --arg sid "$sid" \
    --arg puuid "$pane_uuid" \
    --arg cwd "${cwd:-$pane_cwd}" --arg src "reconcile" --arg model "" \
    --arg tr "$transcript" --arg sn "$session_name" --arg wn "$window_name" \
    --arg cpid "${claude_pid:-}" \
    '{ts:$ts, kind:"session_start", session_id:$sid, pane_uuid:$puuid,
      cwd:$cwd, source:$src, model:$model, transcript_path:$tr,
      session_name:$sn, window_name:$wn} +
     (if $cpid == "" then {} else {claude_pid:($cpid | tonumber)} end)')"
  rebuild_meta "$window_uuid"
}

# Shared body for the four busy-tracking claude hooks. Always drains stdin —
# claude pipes hook-event JSON there, and not draining can stall the claude side
# on small writes. When $2 ("reconcile") is set, the JSON is captured instead of
# discarded and handed to reconcile_active_session so a forked pane self-heals to
# its real session id (see above); only the low-frequency user_prompt_submit/stop
# hooks pass it, keeping pre/post_tool_use on the zero-jq fast path. Also looks up
# the calling claude's pid for the busy marker body (troubleshooting cross-ref).
__busy_hook() {
  local action="$1"        # "mark" | "clear"
  local reconcile="${2:-}" # non-empty → capture stdin and reconcile the active sid
  local json=""
  if [ -n "$reconcile" ]; then
    json="$(cat)"
  else
    cat >/dev/null 2>&1 || true
  fi
  local pane_id="${TMUX_PANE:-}"
  [ -z "$pane_id" ] && return 0
  [ -z "${TMUX:-}" ] && return 0
  local pane_uuid
  pane_uuid="$(tmux_get_pane_uuid "$pane_id" 2>/dev/null || true)"
  [ -z "$pane_uuid" ] && return 0
  case "$action" in
    mark)
      local claude_pid
      claude_pid="$(find_my_claude_pid 2>/dev/null || true)"
      mark_busy "$pane_uuid" "$claude_pid"
      ;;
    clear) clear_busy "$pane_uuid" ;;
  esac
  [ -n "$reconcile" ] && reconcile_active_session "$pane_id" "$pane_uuid" "$json"
  return 0
}

cmd_user_prompt_submit() { __busy_hook mark  reconcile ; }
cmd_pre_tool_use()       { __busy_hook mark ; }           # refreshes mtime mid-run
cmd_post_tool_use()      { __busy_hook mark ; }           # refreshes mtime mid-run
cmd_stop()               { __busy_hook clear reconcile ; }

# --- Hibernation layer (two-stage focus-driven pane suspension) -------------
#
# Stage 1 (SOFT): after CLAUDE_RESCUE_SOFT_DELAY (default 60min) of focus-out,
#   capture the pane scrollback to disk, then `tmux send-keys C-z`. The pane's
#   tty driver issues SIGTSTP to the foreground process group, claude (and any
#   uv/python tool children) stop cleanly, and the shell takes the terminal
#   back. Resume via shell job control (fg) preserves session and unfreezes
#   children correctly — unlike a raw `kill -STOP` / `kill -CONT` pair which
#   does not restore tcsetpgrp and can leave claude+children stuck in T after
#   the resume signal is delivered.
#
# Stage 2 (HARD): if the pane stays defocused and soft-hibernated for
#   CLAUDE_RESCUE_HARD_DELAY (default 24h), wake claude with `fg<Enter>` then
#   send `/exit<Enter>` for a clean shutdown (fires claude's SessionEnd, flushes
#   the transcript). Falls back to SIGTERM → SIGKILL on the recorded claude pids
#   if `/exit` doesn't terminate within ~3s. Frees all resources. The capture
#   file stays on disk for `claude-rescue print` so the user can recall context
#   and resume the session from the picker. The shell prompt is then pre-filled
#   with `clr <session_id>` (no Enter) so resume is one keystroke away.
#   (Task #48 tracks moving away from `/exit` to Ctrl+C × 2 to avoid polluting
#   claude's command history.)
#
# Resume (focus-in): hibernate-resume is called by the pane-focus-in tmux
#   hook. Soft → `fg<Enter>`. Hard → no-op (claude is gone; capture remains).
#
# Capture is the universal first step: written before the soft signal fires,
# so even if the send-keys path is broken, we still have the snapshot. The
# hard upgrade reuses the same capture (claude was suspended in between and
# couldn't have changed pane content).

cmd_hibernate_arm() {
  # Args: $1 = pane_id, $2 = pane_pid (root of pane's process tree).
  #       $3 = force mode ("" = normal focus-driven arm; "hard" = on-demand
  #            from the prefix+a config popup: skip the SOFT/HARD delays, the
  #            busy-defer, and both active-pane guards, and drive claude
  #            straight to a hard /exit right now). See cmd_hibernate_now.
  local pane_id="${1:-}" pane_pid="${2:-}" force="${3:-}"
  [ -n "$pane_id" ] || return 0
  [ -n "$pane_pid" ] || return 0

  # Fast guard: panes that have never run claude have no @claude-pane-id and
  # nothing worth hibernating. Skips a 60-minute disowned timer for every
  # focus-out on a plain shell pane.
  local _puuid
  _puuid="$(tmux_get_pane_uuid "$pane_id" 2>/dev/null || true)"
  [ -n "$_puuid" ] || return 0

  # Per-session opt-out: if the session bound to this pane has
  # suspend_hibernation set (via the `prefix + a` config popup), do NOT arm —
  # neither soft (Ctrl+Z) nor hard (/exit). Bailing here covers BOTH entry
  # points, since the pane-focus-out hook and arm-sweep both land in
  # hibernate-arm. Resolved by the pane's active session_id, the same key the
  # popup writes under.
  #
  # A forced on-demand hibernation (force=hard) bypasses this guard: the user
  # explicitly asked for it via the popup, so the "never auto-suspend" opt-out
  # (which is about focus-driven arming) does not apply. cmd_hibernate_now
  # additionally clears the suspend_hibernation flag so the two don't disagree.
  local _sid _cfg _susp
  _sid="$(read_active_session "$_puuid" 2>/dev/null || true)"
  if [ "$force" != "hard" ] && [ -n "$_sid" ]; then
    _cfg="$(resolve_session_config "$_sid" 2>/dev/null || true)"
    [ -n "$_cfg" ] || _cfg='{}'
    _susp="$(jq -r '.suspend_hibernation // false' <<<"$_cfg" 2>/dev/null || echo false)"
    if [ "$_susp" = "true" ]; then
      log_err "hibernate-arm: suspended for session $_sid (pane $pane_id) — not arming"
      return 0
    fi
  fi

  local SOFT_DELAY="${CLAUDE_RESCUE_SOFT_DELAY:-3600}"
  local HARD_DELAY="${CLAUDE_RESCUE_HARD_DELAY:-86400}"
  local DEFER_TIMES="${CLAUDE_RESCUE_HIBERNATE_DEFER_TIMES:-3}"
  local DEFER_SECONDS="${CLAUDE_RESCUE_HIBERNATE_DEFER_SECONDS:-60}"
  local TARGET_COMM="${CLAUDE_RESCUE_TARGET_COMM:-claude}"

  local arm_pid_file; arm_pid_file="$(arm_pid_path "$pane_id")"
  local hibernated_file; hibernated_file="$(hibernated_marker_path "$_puuid")"

  # If a timer is already running for this pane, leave it. "Running" means:
  # pid alive AND its argv shows it's actually an arm subshell — defends
  # against pid recycling (a stale arm.pid pointing at an unrelated process
  # would otherwise block us from arming for the rest of the kernel pid
  # rollover window).
  if [ -f "$arm_pid_file" ]; then
    local prev_pid prev_args
    prev_pid="$(cat "$arm_pid_file" 2>/dev/null || true)"
    if [ -n "$prev_pid" ] && kill -0 "$prev_pid" 2>/dev/null; then
      prev_args="$(ps -o args= -p "$prev_pid" 2>/dev/null)"
      if printf '%s' "$prev_args" | grep -qE "claude-rescue-log (hibernate-arm|arm-sweep)"; then
        # A timer is already live for this pane. Normally we defer to it; a
        # forced on-demand hibernation takes over — kill it and proceed now.
        if [ "$force" = "hard" ]; then
          kill "$prev_pid" 2>/dev/null || true
        else
          return 0
        fi
      fi
    fi
    rm -f "$arm_pid_file"
  fi

  (
    exec </dev/null >/dev/null 2>>"$CLAUDE_RESCUE_CACHE_HOME/hibernate.err"

    # Survive the spawner's context dying mid-pipeline. The config-popup path
    # is the observed case (2026-07-16): closing the popup (Esc) while a forced
    # hibernation was in flight HUP'd the popup's process group — claude had
    # /exited but the print + `clr <sid>` pre-fill never arrived. The parent's
    # `trap '' HUP` below runs AFTER the fork and never reaches this subshell;
    # ignore it here, first thing.
    trap '' HUP

    # Discover our own pid in a way that works on bash 3.2 (no $BASHPID).
    # `exec sh -c 'echo $PPID'` makes sh REPLACE the command-substitution
    # subshell at the same pid, then echo its parent's pid — which is *this*
    # outer subshell.
    local MY_PID
    MY_PID="$(exec sh -c 'echo $PPID')"

    # Orphan-safety: this subshell is detached from its tmux server (run-shell
    # -b). On kill -9 / teardown the server dies but we keep sleeping; when we
    # wake, the pane_id we captured might belong to a brand-new unrelated pane
    # on a fresh server (or no server at all). Before every side effect we
    # verify (a) the arm pid file still names *this* subshell and (b) the
    # pane's @claude-pane-id still matches the one we armed against. Either
    # mismatch → exit silently without touching tmux or any pid.
    arm_check() {
      if ! arm_still_authoritative "$arm_pid_file" "$MY_PID" "$pane_id" "$_puuid"; then
        exit 0
      fi
    }

    # ===== STAGE 1: SOFT (capture + Ctrl+Z) =====
    # Normal path waits out SOFT_DELAY, then defers while busy and bails if the
    # pane is focused. A forced on-demand hibernation skips all three: no wait,
    # no busy-defer (the user asked for it even mid-run), and no active-pane
    # guard (the pane IS focused — the popup was opened on top of it).
    local active pids
    if [ "$force" != "hard" ]; then
      sleep "$SOFT_DELAY"
      arm_check

      # Busy-aware defer (UserPromptSubmit/Pre|PostToolUse touch the busy file;
      # Stop clears it). Skips title-spinner regex which depended on the
      # configured theme's streaming glyph.
      for _ in $(seq 1 "$DEFER_TIMES"); do
        if is_busy "$_puuid"; then sleep "$DEFER_SECONDS"; arm_check; else break; fi
      done

      if is_busy "$_puuid"; then
        cmd_hibernated "$pane_id" "skip:busy" "skip" 2>/dev/null || true
        rm -f "$arm_pid_file"
        exit 0
      fi

      active="$(tmux display-message -p -t "$pane_id" -F '#{window_active}#{pane_active}' 2>/dev/null || echo "00")"
      if [ "$active" = "11" ]; then
        rm -f "$arm_pid_file"
        exit 0
      fi
    fi

    # Walk pane process tree for record-keeping. We don't actually signal
    # individual PIDs anymore (Ctrl+Z via terminal handles the whole pgid),
    # but we record what claude PIDs were live at hibernation time.
    pids="$(subtree_pids "$pane_pid" "$TARGET_COMM" | sort -u | tr '\n' ' ')"

    if [ -z "${pids// /}" ]; then
      rm -f "$arm_pid_file"
      exit 0
    fi

    # === Capture pane scrollback FIRST (before any signal). Universal — the
    # hard-upgrade stage reuses this exact capture. ===
    local window_uuid session_id cwd capture_txt capture_meta
    window_uuid="$(tmux_get_window_uuid "$pane_id" 2>/dev/null || true)"
    session_id=""
    [ -n "$window_uuid" ] && \
      session_id="$(latest_open_session_in_pane "$window_uuid" "$_puuid" 2>/dev/null || true)"
    cwd="$(tmux display-message -p -t "$pane_id" -F '#{pane_current_path}' 2>/dev/null || echo "")"
    capture_txt="$(capture_txt_path "$_puuid")"
    capture_meta="$(capture_meta_path "$_puuid")"
    if tmux capture-pane -peJ -S - -t "$pane_id" > "$capture_txt.tmp" 2>/dev/null; then
      mv "$capture_txt.tmp" "$capture_txt"
    else
      rm -f "$capture_txt.tmp"
    fi
    # Fallback: if no session_id was recoverable from the event log (claude
    # was started via a path that never fired SessionStart through our hook —
    # e.g. /resume from another session, find-sessions fallback that bypassed
    # cmd_session_start, or a window-log rebuild that lost the row), scrape
    # the visible UUID from the capture we just wrote. This is the same
    # signal capture-truthful-sids.sh uses for hibernated panes; doing it
    # here ensures the meta file is authoritative without a second tool run.
    if [ -z "$session_id" ] && [ -r "$capture_txt" ]; then
      session_id="$(scrape_session_id_from_capture "$capture_txt")"
    fi
    jq -nc \
      --arg pane_uuid "$_puuid" \
      --arg window_uuid "${window_uuid:-}" \
      --arg session_id "${session_id:-}" \
      --arg pane_id "$pane_id" \
      --arg ts "$(now_iso)" \
      --arg cwd "$cwd" \
      --arg pids "$pids" \
      '{pane_uuid:$pane_uuid, window_uuid:$window_uuid, session_id:$session_id,
        pane_id:$pane_id, ts:$ts, cwd:$cwd,
        pids:($pids | gsub("^ +| +$";"") | split(" "))}' \
      > "$capture_meta.tmp" \
      && mv "$capture_meta.tmp" "$capture_meta"

    # === Soft hibernate: send Ctrl+Z. The tty driver issues SIGTSTP to the
    # foreground process group, the shell takes terminal control back.
    # A forced hibernation skips the suspend: stage 2 runs immediately, so
    # suspending claude only to fg it back a beat later wastes ~2s and flashes
    # the pane. The soft marker below is still written either way — stage 2's
    # mode=soft sanity check is the shared state machine, forced or not. ===
    if [ "$force" != "hard" ]; then
      send_keys_logged "hibernate-soft-suspend" "$pane_id" C-z
    fi

    # `forced` tells cmd_hibernate_resume this soft marker is a forced run's
    # in-flight state, not a suspended claude: the pane's foreground is still
    # the LIVE claude until /exit lands a beat later. Focus-in during that
    # window (the popup closing refocuses the pane) must be a no-op — an
    # `fg<Enter>` there would be typed INTO claude as a prompt, and killing
    # the arm subshell would cancel the hibernation the user explicitly asked
    # for.
    local _forced=false
    [ "$force" = "hard" ] && _forced=true
    jq -nc --arg pane "$pane_id" --arg puuid "$_puuid" --arg ts "$(now_iso)" \
           --arg pids "$pids" --arg mode "soft" --argjson forced "$_forced" \
      '{pane_id:$pane, pane_uuid:$puuid, ts:$ts, mode:$mode, forced:$forced,
        pids:($pids | gsub("^ +| +$";"") | split(" "))}' \
      > "$hibernated_file"

    cmd_hibernated "$pane_id" "$pids" "soft" 2>/dev/null || true

    # ===== STAGE 2: HARD (fg + /exit + print + pre-fill, with SIGTERM/SIGKILL
    # fallback; forced runs skip the fg — claude was never suspended) =====
    # A forced hibernation escalates straight through: no HARD_DELAY wait and
    # no active-pane guard. The marker/mode sanity checks below still run — the
    # soft stage above just wrote a fresh soft marker, so they pass.
    if [ "$force" != "hard" ]; then
      local hard_remaining=$((HARD_DELAY - SOFT_DELAY))
      if [ "$hard_remaining" -le 0 ]; then
        rm -f "$arm_pid_file"
        exit 0
      fi
      sleep "$hard_remaining"
      arm_check
    fi

    # Bail out if the hibernated marker is gone (resume already happened) or
    # already hard, or pane is currently focused.
    [ -f "$hibernated_file" ] || { rm -f "$arm_pid_file"; exit 0; }
    local current_mode
    current_mode="$(hibernated_marker_field "$_puuid" mode)"
    [ "$current_mode" = "soft" ] || { rm -f "$arm_pid_file"; exit 0; }

    if [ "$force" != "hard" ]; then
      active="$(tmux display-message -p -t "$pane_id" -F '#{window_active}#{pane_active}' 2>/dev/null || echo "00")"
      if [ "$active" = "11" ]; then
        rm -f "$arm_pid_file"
        exit 0
      fi
    fi

    # Wake claude (fg restores tcsetpgrp + SIGCONT) — only needed when the
    # soft stage actually suspended it; a forced run left claude live in the
    # foreground, so `/exit` goes straight in. `/exit<Enter>` is claude's own
    # slash command — fires SessionEnd cleanly, flushes transcript, claude
    # exits gracefully. Fall back to SIGTERM then SIGKILL if claude is still
    # alive (e.g. mid-stream and ignoring slash commands).
    if [ "$force" != "hard" ]; then
      send_enter_burst "hibernate-hard-fg" "$pane_id" "fg"
      sleep 1
    fi
    # Into claude's input box: the C-u clears any draft the user left, so
    # /exit lands as a clean slash command instead of appended to it (which
    # would fail to parse and fall through to the SIGTERM ladder).
    send_enter_burst "hibernate-hard-exit" "$pane_id" "/exit"

    # Poll for claude's exit instead of a fixed 3s nap — it usually exits well
    # under a second; the ~3s ceiling for the mid-stream case is unchanged.
    local pid _w _alive
    for _w in $(seq 1 15); do
      _alive=""
      for pid in $pids; do
        kill -0 "$pid" 2>/dev/null && { _alive=1; break; }
      done
      [ -n "$_alive" ] || break
      sleep 0.2
    done

    # Check claude is gone; if not, escalate. Each kill is guarded by
    # kill_only_if_comm — recorded pids might have been recycled to unrelated
    # processes after a long defocus + claude crash + new program reusing pid.
    local still_alive=""
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then
        still_alive="$still_alive $pid"
      fi
    done
    if [ -n "${still_alive// /}" ]; then
      for pid in $still_alive; do
        kill_only_if_comm TERM "$pid" "$TARGET_COMM" || true
      done
      sleep 2
      still_alive=""
      for pid in $pids; do
        if kill -0 "$pid" 2>/dev/null; then
          # Re-confirm comm — between TERM and now the pid could have died
          # and been recycled; we already filtered, just re-list survivors.
          still_alive="$still_alive $pid"
        fi
      done
      if [ -n "${still_alive// /}" ]; then
        for pid in $still_alive; do
          kill_only_if_comm KILL "$pid" "$TARGET_COMM" || true
        done
      fi
    fi

    jq --arg mode "hard" --arg ts "$(now_iso)" \
       '. + {mode:$mode, hard_ts:$ts}' \
       "$hibernated_file" > "$hibernated_file.tmp" \
       && mv "$hibernated_file.tmp" "$hibernated_file"

    # claude runs on the ALTERNATE screen, so on exit the pane reverts to the
    # pre-claude shell content plus claude's own resume hint — the session's
    # last screen is NOT visible. (An older assumption here — "/exit doesn't
    # clear the screen, the pane still shows the pre-suspend content" — no
    # longer holds.) Wait for the shell to own the foreground again, then
    # repaint the capture and pre-fill the resume recipe.
    local shell_cmd=""
    for _w in $(seq 1 10); do
      shell_cmd="$(tmux display-message -p -t "$pane_id" -F '#{pane_current_command}' 2>/dev/null || echo '')"
      is_shell_cmd "$shell_cmd" && break
      sleep 0.2
    done

    # Repaint the capture — the peek that shows what the session was without
    # resuming it. Same Enter discipline as the post-restore path (see
    # cmd_resurrect_restore): C-u + command + Enter travel in ONE atomic
    # send-keys call, so this Enter can only ever execute the bare read-only
    # print; gated on the foreground actually being a shell (per the poll
    # above) so it can never be submitted into anything else as input.
    if is_shell_cmd "$shell_cmd" && [ -f "$capture_txt" ]; then
      send_enter_burst "hibernate-hard-print" "$pane_id" "claude-rescue print"
      # Let print finish so the pre-fill lands on a fresh prompt line.
      sleep 1
    fi

    # Pre-fill `clr <session_id>` at the shell prompt (no Enter — user hits
    # Enter when ready).
    local resume_sid
    resume_sid="$(capture_meta_field "$_puuid" session_id)"
    if [ -n "$resume_sid" ]; then
      # C-u first, mirroring the post-restore pre-fill: clears any stray text
      # the shell may have on the line before typing the resume recipe. No cwd
      # anchor here — absent a restore the pane keeps its launch dir, so a bare
      # `clr <sid>` already resolves.
      send_keys_logged "hibernate-hard-clr" "$pane_id" C-u "clr $resume_sid"
    fi

    cmd_hibernated "$pane_id" "$pids" "hard" 2>/dev/null || true
    rm -f "$arm_pid_file"
  ) &
  echo $! > "$arm_pid_file"
  disown 2>/dev/null || true
  trap '' HUP
}

cmd_hibernate_resume() {
  # Cancel any pending hibernate-arm timer and unfreeze the pane based on the
  # mode it was hibernated as.
  #
  # Soft → `fg<Enter>` (shell resumes the suspended claude job, tcsetpgrp
  # restored). Marker + unhibernated event fire here: same claude session
  # continues, no session_start will arrive to clean up later.
  #
  # Hard → true no-op. Claude is dead; the marker is the only state protecting
  # against a crash *after* focus-in (the `clr <sid>` text on the prompt is
  # live readline input, not captured by tmux-resurrect). Marker is cleaned
  # up by cmd_session_start when claude actually starts again — whether via
  # the pre-filled `clr <sid>` or a fresh `cl` for a brand-new session. If
  # the pane dies without ever resuming, cmd_pane_died cleans it up.
  local pane_id="${1:-}"
  [ -n "$pane_id" ] || return 0

  local pane_uuid
  pane_uuid="$(tmux_get_pane_uuid "$pane_id" 2>/dev/null || true)"

  local arm_pid_file; arm_pid_file="$(arm_pid_path "$pane_id")"

  # Read the hibernation mode (if any) BEFORE deciding whether to kill the arm
  # subshell. The arm subshell's role changes by phase:
  #
  #   - pre-soft (no marker yet): the timer is just sleeping; we want to cancel
  #     it so the focused pane doesn't get hibernated.
  #   - soft (marker mode=soft): claude is suspended, the subshell is sleeping
  #     toward hard escalation. Cancel it; we're about to fg<Enter> the job.
  #   - hard (marker mode=hard): claude is already gone. The subshell is in its
  #     short post-/exit cleanup window — painting the capture and sending
  #     `clr <sid>` to the prompt, emitting the hibernated event, removing its
  #     own arm.pid. Killing it now drops the print + `clr <sid>` pre-fill
  #     (the user sees a bare prompt). Leave it.
  #   - forced soft (marker mode=soft, forced=true): a forced hibernation's
  #     in-flight state — claude is NOT suspended, it is live in the foreground
  #     until the /exit a beat later. Treat exactly like hard: no arm kill (it
  #     would cancel what the user explicitly asked for), no fg (it would be
  #     typed INTO claude as a prompt).
  local hibernated_file=""
  local mode="" forced=""
  if [ -n "$pane_uuid" ]; then
    hibernated_file="$(hibernated_marker_path "$pane_uuid")"
    if [ -f "$hibernated_file" ]; then
      mode="$(hibernated_marker_field "$pane_uuid" mode)"
      forced="$(hibernated_marker_field "$pane_uuid" forced false)"
    fi
  fi

  if [ "$mode" != "hard" ] && [ "$forced" != "true" ] && [ -f "$arm_pid_file" ]; then
    local arm_pid
    arm_pid="$(cat "$arm_pid_file" 2>/dev/null || true)"
    if [ -n "$arm_pid" ] && kill -0 "$arm_pid" 2>/dev/null; then
      # Only kill if the pid is plausibly an arm subshell. Defends against
      # pid recycling — without this, a stale arm.pid file whose pid was
      # reassigned to an unrelated process could cause us to kill it.
      local arm_args
      arm_args="$(ps -o args= -p "$arm_pid" 2>/dev/null)"
      if printf '%s' "$arm_args" | grep -qE "claude-rescue-log (hibernate-arm|arm-sweep)"; then
        kill "$arm_pid" 2>/dev/null || true
      fi
    fi
    rm -f "$arm_pid_file"
  fi

  [ -z "$hibernated_file" ] && return 0
  [ -f "$hibernated_file" ] || return 0

  case "$mode" in
    soft)
      # Forced in-flight soft: claude is live, not suspended — no-op, the
      # forced pipeline finishes on its own (see the phase table above).
      [ "$forced" = "true" ] && return 0
      send_enter_burst "hibernate-resume-fg" "$pane_id" "fg"
      rm -f "$hibernated_file"
      cmd_unhibernated "$pane_id" "$mode" 2>/dev/null || true
      ;;
    hard)
      # No-op. Marker survives until session_start (real resume) or
      # pane_died (orphan cleanup). The in-flight arm subshell (if any)
      # finishes its `clr <sid>` send-keys and removes its own arm.pid.
      :
      ;;
  esac
}

# --- On-demand hibernation (prefix + a config popup) ------------------------
#
# The automatic layer above is focus-driven. These three entry points let the
# user drive it by hand from the config popup: a single row that flips between
# "hibernate now" and "restore" depending on the pane's current state.

# Report a pane's hibernation state as none|soft|hard, so the popup can pick
# the right label (hibernate vs restore).
cmd_hibernate_state() {
  local pane_id="${1:-}"
  [ -n "$pane_id" ] || { echo none; return 0; }
  local puuid marker mode
  puuid="$(tmux_get_pane_uuid "$pane_id" 2>/dev/null || true)"
  [ -n "$puuid" ] || { echo none; return 0; }
  marker="$(hibernated_marker_path "$puuid")"
  [ -f "$marker" ] || { echo none; return 0; }
  mode="$(hibernated_marker_field "$puuid" mode)"
  case "$mode" in
    soft) echo soft ;;
    hard) echo hard ;;
    *)    echo none ;;
  esac
}

# Force a hard hibernation of a pane right now. Resolves the pane's process-tree
# root and drives cmd_hibernate_arm in force=hard mode (no delays, no busy /
# active guards, no Ctrl+Z/fg dance → capture, /exit, print + pre-fill
# `clr <sid>`). The arm function
# backgrounds + disowns the actual work, so this returns immediately.
cmd_hibernate_now() {
  local pane_id="${1:-}"
  [ -n "$pane_id" ] || return 0
  local pane_pid
  pane_pid="$(tmux display-message -p -t "$pane_id" -F '#{pane_pid}' 2>/dev/null || true)"
  [ -n "$pane_pid" ] || return 0

  # Clearing suspend_hibernation keeps the popup honest: forcing hibernation
  # while "never suspend" is still ticked would be contradictory, and leaving
  # it set would let the arm-sweep decline to re-arm this pane later. Resolve
  # the same session id the popup writes under.
  local puuid sid
  puuid="$(tmux_get_pane_uuid "$pane_id" 2>/dev/null || true)"
  if [ -n "$puuid" ]; then
    sid="$(read_active_session "$puuid" 2>/dev/null || true)"
    [ -n "$sid" ] && set_session_config_value "$sid" suspend_hibernation false 2>/dev/null || true
  fi

  cmd_hibernate_arm "$pane_id" "$pane_pid" hard
}

# Restore a hibernated pane on demand, choosing the mechanism that fits the
# pane's current shape:
#   soft (claude Ctrl+Z'd, job suspended) -> `fg` — reuse the focus-in resume.
#   hard (claude /exited, plain shell)    -> type `clr <sid>` and run it.
# The hard branch is the "smart about a text shell" part: there is no suspended
# job to fg, so we issue the resume recipe at the shell prompt instead. C-u
# first clears any partial line (e.g. the `clr <sid>` the hard stage pre-filled
# without Enter). The hard marker is left in place — it is the crash-restore
# insurance, and cmd_session_start clears it once claude comes back up.
cmd_restore_now() {
  local pane_id="${1:-}"
  [ -n "$pane_id" ] || return 0
  local puuid marker mode
  puuid="$(tmux_get_pane_uuid "$pane_id" 2>/dev/null || true)"
  [ -n "$puuid" ] || return 0
  marker="$(hibernated_marker_path "$puuid")"
  [ -f "$marker" ] || return 0
  mode="$(hibernated_marker_field "$puuid" mode)"
  case "$mode" in
    soft)
      cmd_hibernate_resume "$pane_id"
      ;;
    hard)
      # active/<pane_uuid> is the session-id authority (hook-driven identity,
      # 8419670) and survives hard-exit while a marker exists; the frozen
      # capture meta is only the fallback.
      local sid
      sid="$(read_active_session "$puuid" 2>/dev/null || true)"
      [ -n "$sid" ] || sid="$(capture_meta_field "$puuid" session_id)"
      [ -n "$sid" ] && send_enter_burst "restore-now-clr" "$pane_id" "clr $sid"
      ;;
  esac
}

# Arm every backgrounded claude pane that isn't already armed. Triggered on
# client-attached (and session/window changes if wired) so users don't have
# to physically visit each pane to start its hibernation countdown.
#
# pane-focus-out only fires for *the currently-focused* pane transitioning
# away — it never fires for panes that are inactive-in-window or for panes
# the user simply never visited. This sweep fills that gap: at the moments
# we know the client is engaging with the server, we arm all eligible
# backgrounded panes idempotently (per-pane arm.pid check skips already-armed).
cmd_arm_sweep() {
  local pane_id win_act pane_act puuid pane_pid cur_cmd arm_pid_file
  while IFS=$'\t' read -r pane_id win_act pane_act puuid pane_pid cur_cmd; do
    [ -n "$pane_id" ] || continue
    # Fast guard: pane never ran claude → no work.
    [ -n "$puuid" ] || continue

    # Voluntary-exit detection: pane has a claude UUID but isn't running
    # claude. Catches the SIGKILL / dismiss-"Resume from summary?" / any
    # hook-skipping exit path. Treat as if SessionEnd fired: drop arm.pid,
    # drop active-session file, unset @claude-pane-id.
    #
    # Guards (any one → skip cleanup):
    #   - claude process alive as a direct child of pane_pid: claude is
    #     still running but transiently delegating pane_current_command to
    #     a tool subprocess (Bash, etc.). pgrep -x ensures comm=="claude"
    #     exactly, so something incidentally containing "claude" in argv
    #     doesn't false-positive. This guard fires on the race we observed
    #     on the 2026-05-12 rollout follow-up: %10 (merge-http-client) had
    #     its @claude-pane-id wiped by arm-sweep mid-tool-exec, with no
    #     hibernation marker and no busy marker, despite claude being very
    #     much alive a few PIDs deeper than pane_current_command revealed.
    #   - busy marker present: claude itself signaled it's about to exec a
    #     subprocess. Independent of the pgrep check — the marker is set
    #     by Claude Code hooks before pane_current_command flips.
    #   - hibernation marker present: soft means claude is Ctrl+Z'd (T state,
    #     pane_current_command reports the shell, but the arm subshell is
    #     load-bearing for the hard escalation). Hard means claude really
    #     exited, but the marker is the crash-restore insurance that survives
    #     until cmd_session_start cleans it — don't unset puuid out from under
    #     it (the marker is keyed by puuid).
    # Note on the pgrep arg order: BSD pgrep (macOS) stops parsing options
    # at the first non-option arg (the pattern). `pgrep -x claude -P PID`
    # treats `-P PID` as an additional pattern, NOT as the -P selector —
    # effectively returning every claude process system-wide. Always put
    # selectors BEFORE the pattern. See `man pgrep` synopsis.
    if [ "$cur_cmd" != "claude" ] \
       && ! pgrep -P "$pane_pid" -x claude >/dev/null 2>&1 \
       && ! is_busy "$puuid" \
       && [ ! -f "$(hibernated_marker_path "$puuid")" ]; then
      rm -f "$(arm_pid_path "$pane_id")"
      clear_active_session "$puuid"
      tmux_unset_pane_uuid "$pane_id"
      continue
    fi

    # Currently focused (active pane in an active window): leave it alone.
    [ "$win_act$pane_act" = "11" ] && continue
    arm_pid_file="$(arm_pid_path "$pane_id")"
    # Already armed (file present AND the recorded pid is alive AND is a real
    # hibernate-arm subshell): don't reset the timer.
    if [ -f "$arm_pid_file" ]; then
      local existing_pid existing_args
      existing_pid="$(cat "$arm_pid_file" 2>/dev/null)"
      if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
        existing_args="$(ps -o args= -p "$existing_pid" 2>/dev/null)"
        if printf '%s' "$existing_args" | grep -qE "claude-rescue-log (hibernate-arm|arm-sweep)"; then
          continue
        fi
      fi
      # Stale file (dead pid or pid recycled to unrelated process). Remove
      # and re-arm fresh.
      rm -f "$arm_pid_file"
    fi
    cmd_hibernate_arm "$pane_id" "$pane_pid" 2>/dev/null || true
  done < <(tmux list-panes -aF $'#{pane_id}\t#{window_active}\t#{pane_active}\t#{@claude-pane-id}\t#{pane_pid}\t#{pane_current_command}' 2>/dev/null)
}

# --- Dispatch ---------------------------------------------------------------

cmd="${1:-}"; shift || true
case "$cmd" in
  session_start)      cmd_session_start "$@" ;;
  session_end)        cmd_session_end "$@" ;;
  user_prompt_submit) cmd_user_prompt_submit "$@" ;;
  pre_tool_use)       cmd_pre_tool_use "$@" ;;
  post_tool_use)      cmd_post_tool_use "$@" ;;
  stop)               cmd_stop "$@" ;;
  title)              cmd_title "$@" ;;
  title-commit)       cmd_title_commit "$@" ;;
  title-now)          cmd_title_now "$@" ;;
  pane-died)          cmd_pane_died "$@" ;;
  pane-created)       cmd_pane_created "$@" ;;
  alert-activity)     cmd_alert_activity "$@" ;;
  alert-bell)         cmd_alert_bell "$@" ;;
  client-detached)    cmd_client_detached "$@" ;;
  hibernated)         cmd_hibernated "$@" ;;
  unhibernated)       cmd_unhibernated "$@" ;;
  resurrect-save)             cmd_resurrect_save "$@" ;;
  resurrect-restore)          cmd_resurrect_restore "$@" ;;
  resurrect-pre-restore-all)  cmd_resurrect_pre_restore_all "$@" ;;
  resurrect-post-restore-all) cmd_resurrect_post_restore_all "$@" ;;
  hibernate-arm)      cmd_hibernate_arm "$@" ;;
  hibernate-resume)   cmd_hibernate_resume "$@" ;;
  hibernate-now)      cmd_hibernate_now "$@" ;;
  hibernate-state)    cmd_hibernate_state "$@" ;;
  restore-now)        cmd_restore_now "$@" ;;
  arm-sweep)          cmd_arm_sweep "$@" ;;
  '')                 log_err "no subcommand"; exit 2 ;;
  *)                  log_err "unknown subcommand: $cmd"; exit 2 ;;
esac

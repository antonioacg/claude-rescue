#!/usr/bin/env bash
# claude-rescue — find and resume a Claude Code session.
#
# Top-level usage:
#   claude-rescue              Open the picker in a tmux popup and type the
#                              chosen session's resume command into the pane it
#                              was opened from. Bound to prefix+R.
#
# The picker searches the TRANSCRIPT CORPUS (claude's own jsonl) by content
# with ripgrep, orders by last-active, and scopes to $PWD's project by default
# — tab widens to all projects. Sessions a live pane already holds are labelled
# with that pane and cannot be selected, because two claudes on one transcript
# corrupt it.
#
# Picker subcommands (the fzf callbacks; `pick` is also useful on its own):
#   pick [query]                    Print the chosen session id, nothing on
#                                   cancel. This is what `clr` calls.
#   index                           The session index, newest first (debug).
#   pick-rows [--scope cwd|all] [--state F] [query]
#   pick-header F / pick-toggle F / pick-preview <sid> / pick-copy <sid>
#   live-sessions                   session_id TAB session:window.pane for
#                                   sessions a live pane still holds.
#
# Transcript-corpus subcommands (claude's own jsonl under ~/.claude/projects,
# not our event log):
#   model <sid>                     Model id to resume <sid> with, or empty.
#   latest [--cwd DIR]              Newest session id for DIR (default $PWD).
#   resume-dir <sid>                Directory <sid> belongs to.
#
# Event-log subcommands (this repo's own History Events):
#   find-sessions [filter ...]      Cross-window session search (used by
#                                   claude-rescue-resume).
#   print [pane_uuid|sid]           Cat a saved pane capture (no arg = current
#                                   pane via @claude-pane-id). Reads from
#                                   $DATA/captures/<pane_uuid>.{txt,json}.
#
# Picker keys:
#   enter     resume in the originating pane
#   tab       toggle scope: this directory / all projects
#   ctrl-y    copy the session id
#   esc       cancel

set -uo pipefail

# Resolve $0 through any symlinks so we find lib/common.sh regardless of how
# this binary was invoked (direct, via ~/.local/bin/ symlink, etc.).
__script="$0"
while [ -L "$__script" ]; do
  __link="$(readlink "$__script")"
  case "$__link" in
    /*) __script="$__link" ;;
    *)  __script="$(cd "$(dirname "$__script")" && pwd)/$__link" ;;
  esac
done
REPO="$(cd "$(dirname "$__script")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$REPO/lib/common.sh"
ensure_dirs

# ---------------------------------------------------------------------------
# Data formatters


# Replace the leading $HOME with ~ for display purposes.
tildify() {
  local p="$1"
  case "$p" in
    "$HOME") echo "~" ;;
    "$HOME"/*) echo "~${p#$HOME}" ;;
    *) echo "$p" ;;
  esac
}


# ---------------------------------------------------------------------------
# Render helpers (humanize TSV → display rows for fzf)


# ---------------------------------------------------------------------------
# Action dispatch

resume_command() {
  # The command the picker types into a pane. `clr`, not `claude --resume`:
  # the front-end repairs the [1m] context window (see the Model repair entry
  # in CONTEXT.md), carries the usual flags, and lands in the session's own
  # directory — so the cd has exactly one owner instead of being decided here
  # too. Same recipe as the crash-restore Pre-fill.
  local sid="$1"
  printf 'clr %q' "$sid"
}

action_resume_here() {
  local sid="$1"
  local target="${CLAUDE_RESCUE_ORIG_PANE:-${TMUX_PANE:-}}"
  if [ -z "$target" ]; then
    echo "no originating pane to send to" >&2
    return 1
  fi
  # Shell gate: the target is whatever pane the picker was opened from. If its
  # foreground isn't a shell (say, a claude already running there), the resume
  # command would be submitted INTO that program as input.
  local cur_cmd
  cur_cmd="$(tmux display-message -p -t "$target" -F '#{pane_current_command}' 2>/dev/null || echo '')"
  if ! is_shell_cmd "$cur_cmd"; then
    tmux display-message "claude-rescue: pane $target is running '$cur_cmd' — not typing a resume into it" 2>/dev/null || true
    return 1
  fi
  send_enter_burst "picker-resume-here" "$target" " $(resume_command "$sid")"
}

action_copy_uuid() {
  local sid="$1"
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$sid" | pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$sid" | xclip -selection clipboard
  else
    echo "no clipboard tool found (pbcopy/xclip); UUID: $sid" >&2
  fi
}

# ---------------------------------------------------------------------------
# Inner picker — runs inside the popup.


# ---------------------------------------------------------------------------
# find-sessions: shared query primitive. Used by the picker filter toggle
# and by the resume wrapper (claude-rescue-resume / @resurrect-processes).
#
# Filters (all optional, AND'd together):
#   --pane-uuid UUID     only sessions whose pane_uuid matches
#   --window-uuid UUID   only sessions inside this window UUID
#   --cwd PATH           only sessions whose cwd equals this path
#   --open-only          only sessions without a matching session_end (still alive)
#
# Output: US-separated TSV, sessions sorted newest-first.
# Columns: session_id, window_uuid, pane_uuid, started, ended, cwd, source, last_title
find_sessions() {
  local pane_uuid_f="" window_uuid_f="" cwd_f="" open_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pane-uuid)   pane_uuid_f="$2"; shift 2 ;;
      --window-uuid) window_uuid_f="$2"; shift 2 ;;
      --cwd)         cwd_f="$2"; shift 2 ;;
      --open-only)   open_only=1; shift ;;
      *) echo "find-sessions: unknown arg: $1" >&2; return 2 ;;
    esac
  done

  local meta_dir="$CLAUDE_RESCUE_DATA_HOME/windows"
  [ -d "$meta_dir" ] || return 0

  shopt -s nullglob
  local metas=("$meta_dir"/*.meta.json)
  shopt -u nullglob
  [ ${#metas[@]} -eq 0 ] && return 0

  # Claude's transcript directory uses the cwd with BOTH `/` and `.` swapped
  # for `-` (so `.local` and `/local` both encode as `-local`), rooted at
  # $CLAUDE_PROJECTS_DIR (default ~/.claude/projects). Sessions claude opened
  # but never received a user message in have no transcript file; resuming
  # such a session via `claude -r <sid>` silently spawns a fresh session,
  # masking the resume. We unconditionally drop them — there's no useful
  # behavior for an entry the user can't actually resume.
  local projects_root="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

  local US=$'\x1f'
  for f in "${metas[@]}"; do
    jq -r --arg US "$US" \
          --arg puuid "$pane_uuid_f" \
          --arg wuuid "$window_uuid_f" \
          --arg cwd "$cwd_f" \
          --argjson open_only "$open_only" '
      .window_uuid as $wu |
      .window_name as $wn |
      (.sessions // [])[] |
      select(
        ($puuid == "" or .pane_uuid == $puuid)
        and ($wuuid == "" or $wu == $wuuid)
        and ($cwd == "" or .cwd == $cwd)
        and ($open_only == 0 or .ended == null)
      )
      | [.session_id, $wu, (.pane_uuid // ""),
         (.started // ""), (.ended // ""),
         (.cwd // ""), (.source // ""),
         (.window_name // $wn // ""),
         (.last_title // "")] | join($US)
    ' "$f"
  done \
  | while IFS= read -r row; do
      local sid="$(printf '%s' "$row" | awk -v FS="$US" '{print $1}')"
      local rcwd="$(printf '%s' "$row" | awk -v FS="$US" '{print $6}')"
      [ -z "$sid" ] && continue
      [ -z "$rcwd" ] && continue
      local enc="${rcwd//\//-}"
      enc="${enc//./-}"
      [ -f "$projects_root/$enc/$sid.jsonl" ] && printf '%s\n' "$row"
    done \
  | sort -t"$US" -k4,4r
}

print_capture() {
  # Usage: claude-rescue print [pane_uuid|session_id]
  #
  # No arg: print the capture for the current pane's @claude-pane-id.
  # With arg: try as pane_uuid first (captures/<arg>.txt). If not found,
  # search meta.json files for a session whose .session_id matches and use
  # its .pane_uuid.
  #
  # Captures are written by claude-rescue-log's hibernate-arm path on hibernation
  # — they're a snapshot of the pane scrollback at the moment SIGSTOP fired.
  # Survives reboots, SIGCONT, and pane death; overwritten only by a subsequent
  # hibernation of the same pane.
  local arg="${1:-}"
  local pane_uuid="" txt="" meta=""

  if [ -z "$arg" ]; then
    if [ -z "${TMUX:-}" ]; then
      echo "claude-rescue print: not inside tmux and no target argument given" >&2
      return 2
    fi
    # Prefer $TMUX_PANE (the pane this script is running IN, set by tmux when
    # spawning the shell). `tmux display-message -p` without -t returns the
    # client's CURRENTLY-ACTIVE pane — wrong when print is invoked from a
    # non-focused pane (e.g. via send-keys from the post-restore-keys path,
    # or from a daemon/hook context). Only fall back to display-message when
    # TMUX_PANE is unset (e.g. `tmux run-shell` invocations don't set it).
    local pane="${TMUX_PANE:-}"
    [ -z "$pane" ] && pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null)"
    if [ -z "$pane" ]; then
      echo "claude-rescue print: cannot determine current pane" >&2
      return 2
    fi
    pane_uuid="$(tmux show-options -pv -t "$pane" @claude-pane-id 2>/dev/null || true)"
    if [ -z "$pane_uuid" ]; then
      echo "claude-rescue print: no @claude-pane-id on current pane (no claude session has run here yet)" >&2
      return 1
    fi
  else
    if [ -f "$(capture_txt_path "$arg")" ]; then
      pane_uuid="$arg"
    else
      shopt -s nullglob
      local metas=("$CLAUDE_RESCUE_DATA_HOME/windows"/*.meta.json)
      shopt -u nullglob
      local f resolved
      for f in "${metas[@]}"; do
        resolved="$(jq -r --arg sid "$arg" '
          (.sessions // [])[]
          | select(.session_id == $sid)
          | .pane_uuid // empty
        ' "$f" 2>/dev/null | head -1)"
        if [ -n "$resolved" ]; then
          pane_uuid="$resolved"
          break
        fi
      done
      if [ -z "$pane_uuid" ]; then
        echo "claude-rescue print: no capture matches '$arg' (tried as pane_uuid and session_id)" >&2
        return 1
      fi
    fi
  fi

  txt="$(capture_txt_path "$pane_uuid")"
  meta="$(capture_meta_path "$pane_uuid")"
  if [ ! -f "$txt" ]; then
    echo "claude-rescue print: no capture on disk for pane_uuid $pane_uuid" >&2
    echo "  (this pane has no hibernation snapshot yet)" >&2
    return 1
  fi

  if [ -f "$meta" ]; then
    local m_ts m_sid m_cwd m_pids
    m_ts="$(jq -r '.ts // ""' "$meta")"
    m_sid="$(jq -r '.session_id // ""' "$meta")"
    m_cwd="$(jq -r '.cwd // ""' "$meta")"
    m_pids="$(jq -r '.pids // [] | join(" ")' "$meta")"
    {
      echo "# claude-rescue capture"
      echo "#   pane_uuid : $pane_uuid"
      [ -n "$m_ts" ]  && echo "#   captured  : $m_ts"
      [ -n "$m_sid" ] && echo "#   claude session id: $m_sid"
      [ -n "$m_cwd" ] && echo "#   cwd       : $m_cwd"
      [ -n "$m_pids" ] && echo "#   stopped pids: $m_pids"
      echo "# ---"
    } >&2
  fi
  cat "$txt"
}

# ---------------------------------------------------------------------------
# Transcript corpus — claude's own jsonl files, at
# $CLAUDE_PROJECTS_DIR/<slug>/<session_id>.jsonl (slug per
# encode_cwd_for_projects). Distinct from this repo's event log: the corpus is
# written by claude itself, covers sessions we never observed, and is the only
# place a session's model is recorded.

projects_root() {
  printf '%s' "${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"
}

# Path to a session's transcript, searching every slug dir. Empty when absent.
# Only <slug>/<sid>.jsonl is a resumable session: subagent transcripts live in
# <slug>/<sid>/subagents/ and `claude --resume` rejects their agent-* stems,
# so the single-level glob is deliberate.
transcript_for_session() {
  local sid="${1:-}" root
  # Guard the glob: a slash or empty arg must never expand into a wider match.
  case "$sid" in ''|*/*) return 0 ;; esac
  root="$(projects_root)"
  shopt -s nullglob
  local hits=("$root"/*/"$sid.jsonl")
  shopt -u nullglob
  [ ${#hits[@]} -gt 0 ] && printf '%s\n' "${hits[0]}"
  return 0
}

# Model id a session must be resumed with, or empty when there is nothing to
# repair.
#
# Claude Code appends an attachment.type=model record on every process start
# (the fresh run and each resume), carrying identity.modelId — the only
# on-disk record of the model a session actually ran with.
#
# Upstream bug anthropics/claude-code#93021: when ANTHROPIC_BASE_URL is not a
# first-party Anthropic host AND the session model differs from settings.json's
# `model`, --resume restores the API-echoed id instead, which never carries the
# `[1m]` suffix. The session comes back with a 200,000-token context window
# instead of 1,000,000 and auto-compacts 5x early, silently. Both preconditions
# hold permanently wherever a gateway fronts the API. Passing --model
# explicitly on resume restores the window; that is what this feeds.
#
# The repair takes the LAST record's id, so an in-session model switch is
# honoured, and re-adds `[1m]` only if SOME record for this session carried it.
# The suffix is the only thing ever added back: this can restore a 1M window,
# but it can never force a different model than the session last used.
#
# Best-effort by contract. This runs in the crash-restore pre-fill path (the
# resume recipe in CONTEXT.md), so every failure mode — no such session, file
# unreadable, malformed lines, no model record at all (true of every transcript
# written before the record existed) — is empty stdout and exit 0. The caller
# then resumes with no --model, exactly as it did before this existed.
#
# grep rather than rg: one file, and the Docker test image ships no ripgrep.
# The pattern is anchored on the record shape, not on the bare key name, so
# transcript text that merely mentions modelId can never be mistaken for the
# record. (Measured equal on today's corpus — tool output is JSON-escaped, so
# an embedded key reads as \"modelId\" and cannot match — but the anchor costs
# nothing and holds if that escaping ever changes.)
session_model() {
  local sid="${1:-}" path ids
  path="$(transcript_for_session "$sid")"
  [ -n "$path" ] && [ -r "$path" ] || return 0
  ids="$(grep -oE '"type":"model","identity":\{"modelId":"[^"]*"' "$path" 2>/dev/null \
         | sed -e 's/.*"modelId":"//' -e 's/"$//')" || return 0
  [ -n "$ids" ] || return 0
  printf '%s\n' "$ids" | awk '
    $0 != "" { last = $0; if ($0 ~ /\[1m\]$/) any = 1 }
    END {
      if (!any || last == "") exit 0
      base = last; sub(/\[1m\]$/, "", base)
      print base "[1m]"
    }'
  return 0
}

# Directory from which `claude -r <sid>` actually resolves this session, or
# empty when no directory does.
#
# claude resolves a resumed session's transcript against $PWD's slug, so
# resuming from the wrong directory does not resume it. This mirrors the
# cwd-rescue guard in claude-rescue-resume: a candidate is accepted only when
# the session's jsonl really exists under that candidate's slug, so a lossy
# de-slug can never send the caller somewhere the resume would fail.
#
# $PWD is tried first, which makes the common `clr <sid>` case a no-op. The
# fallbacks are the cwd values the session recorded on its own events; the
# launch cwd is the one that fixed the slug, but a session can change
# directory mid-run, so each distinct value is offered and the jsonl test
# decides. Bounded to the head of the file: the launch cwd is on an early
# record, and transcripts run to tens of MB.
resume_dir_for_session() {
  local sid="${1:-}" root path cand
  case "$sid" in ''|*/*) return 0 ;; esac
  root="$(projects_root)"
  if [ -f "$root/$(encode_cwd_for_projects "$PWD")/$sid.jsonl" ]; then
    printf '%s\n' "$PWD"
    return 0
  fi
  path="$(transcript_for_session "$sid")"
  [ -n "$path" ] && [ -r "$path" ] || return 0
  while IFS= read -r cand; do
    [ -n "$cand" ] && [ -d "$cand" ] || continue
    if [ -f "$root/$(encode_cwd_for_projects "$cand")/$sid.jsonl" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done <<EOF
$(head -n 200 "$path" 2>/dev/null \
  | grep -oE '"cwd":"[^"]*"' 2>/dev/null \
  | sed -e 's/^"cwd":"//' -e 's/"$//' \
  | awk '!seen[$0]++')
EOF
  return 0
}

# Newest session id for a directory — what `claude -c` approximates. Empty
# when that directory has no transcripts. Single-level glob for the same
# reason as transcript_for_session.
latest_session() {
  local dir="$PWD" root slug newest
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) dir="${2:-}"; shift 2 ;;
      *) echo "latest: unknown arg: $1" >&2; return 2 ;;
    esac
  done
  [ -n "$dir" ] || return 0
  root="$(projects_root)"
  slug="$(encode_cwd_for_projects "$dir")"
  [ -d "$root/$slug" ] || return 0
  newest="$(ls -t "$root/$slug"/*.jsonl 2>/dev/null | head -1)"
  [ -n "$newest" ] || return 0
  newest="${newest##*/}"
  printf '%s\n' "${newest%.jsonl}"
  return 0
}

# ---------------------------------------------------------------------------
# Session picker — fzf over the transcript corpus.

# mtime, size and path for many files in ONE process: a fork per file costs
# more than the scan itself at this corpus size. BSD stat first, GNU second —
# the same probe order as is_busy in claude-rescue-log. Fields are
# space-separated with the path last, so a path containing spaces survives
# (awk rejoins from field 3 onward).
stat_batch() {
  [ $# -gt 0 ] || return 0
  stat -f '%m %z %N' "$@" 2>/dev/null || stat -c '%Y %s %n' "$@" 2>/dev/null
}

session_index_path() { printf '%s/session-index.tsv' "$CLAUDE_RESCUE_CACHE_HOME"; }

# Index of resumable sessions, newest first.
# TSV: session_id, path, mtime, size, launch_cwd, warn, title
#
# Cached and refreshed incrementally. Entries are keyed by (path, mtime, size),
# so reopening the picker rescans only transcripts that actually changed —
# first paint then costs one stat call, not a walk over gigabytes. A cold build
# is three rg passes over the changed set (never per file): one for the title
# and model records, which are rare, and two -m1 passes for the launch cwd and
# the first user message, where rg stops at the first hit per file.
#
# rg --json + jq rather than --with-filename: the output is path plus arbitrary
# matched text, and a title can contain anything including a colon, so there is
# no safe character to split a `path:match` line on. --json separates them
# structurally and jq unescapes the values.
#
# `warn` marks a session whose newest model record is a bare downgrade of an
# earlier [1m] — see the Model repair entry in CONTEXT.md.
session_index() {
  local root cache work
  root="$(projects_root)"
  cache="$(session_index_path)"
  [ -d "$root" ] || return 0
  shopt -s nullglob
  local files=("$root"/*/*.jsonl)
  shopt -u nullglob
  [ ${#files[@]} -gt 0 ] || return 0

  mkdir -p "$CLAUDE_RESCUE_CACHE_HOME" 2>/dev/null || return 0
  work="$CLAUDE_RESCUE_CACHE_HOME/.index-work.$$"
  [ -f "$cache" ] || : > "$cache"

  stat_batch "${files[@]}" \
    | awk '{ m=$1; s=$2; p=$3; for (i=4; i<=NF; i++) p = p " " $i
             n=p; sub(/.*\//, "", n); sub(/\.jsonl$/, "", n)
             print n "\t" p "\t" m "\t" s }' > "$work.now" 2>/dev/null

  # FILENAME, not the usual NR==FNR: on the first run the cache is zero-byte,
  # and an empty first file leaves NR and FNR in lockstep for the whole second
  # file, so NR==FNR would stay true and mark nothing as changed.
  awk -F'\t' -v cf="$cache" 'FILENAME == cf { k[$2] = $3 "\t" $4; next }
                             k[$2] != $3 "\t" $4 { print $2 }' \
      "$cache" "$work.now" > "$work.changed" 2>/dev/null

  : > "$work.attrs"
  if [ -s "$work.changed" ] && command -v rg >/dev/null 2>&1; then
    local jqp='select(.type=="match")
      | .data.path.text as $p | .data.submatches[0].match.text as $m
      | if   ($m|test("^\\{\"type\":\"(ai|custom)-title\"")) then
               [$p,"title",($m|capture("\"(?<k>ai|custom)-title\"").k),
                ($m|capture("Title\":\"(?<v>.*)\"$").v)]
        elif ($m|test("^\"type\":\"model\"")) then
               [$p,"model","",($m|capture("modelId\":\"(?<v>.*)\"$").v)]
        elif ($m|test("^\"cwd\"")) then
               [$p,"cwd","",($m|capture("^\"cwd\":\"(?<v>.*)\"$").v)]
        else   [$p,"msg","",($m|capture("content\":\"(?<v>.*)$").v)] end
      | @tsv'
    tr '\n' '\0' < "$work.changed" | xargs -0 rg --json --no-messages \
        -e '^\{"type":"(ai-title|custom-title)","(aiTitle|customTitle)":"[^"]*"' \
        -e '"type":"model","identity":\{"modelId":"[^"]*"' 2>/dev/null \
      | jq -r "$jqp" >> "$work.attrs" 2>/dev/null
    tr '\n' '\0' < "$work.changed" | xargs -0 rg --json --no-messages -m1 \
        -e '"cwd":"[^"]*"' 2>/dev/null | jq -r "$jqp" >> "$work.attrs" 2>/dev/null
    tr '\n' '\0' < "$work.changed" | xargs -0 rg --json --no-messages -m1 \
        -e '"role":"user","content":"[^"]{1,200}' 2>/dev/null \
      | jq -r "$jqp" >> "$work.attrs" 2>/dev/null
  fi

  # Per-path rollup. Title precedence: the newest /rename, else the newest
  # auto-generated title, else a cleaned-up first user message.
  awk -F'\t' '
    { seen[$1] = 1 }
    $2 == "cwd"   { cwd[$1] = $4 }
    $2 == "model" { lastm[$1] = $4; if ($4 ~ /\[1m\]$/) had1m[$1] = 1 }
    $2 == "msg"   { if (!($1 in msg)) msg[$1] = $4 }
    $2 == "title" { if ($3 == "custom") cust[$1] = $4; else ai[$1] = $4 }
    END {
      for (p in seen) {
        t = (p in cust) ? cust[p] : ((p in ai) ? ai[p] : msg[p])
        gsub(/\\[nrt]|\\"|[\t\r\n]+/, " ", t); gsub(/  +/, " ", t)
        sub(/^ +/, "", t); sub(/ +$/, "", t)
        if (length(t) > 58) t = substr(t, 1, 57) "\xe2\x80\xa6"
        w = (had1m[p] && lastm[p] !~ /\[1m\]$/) ? 1 : ""
        print p "\t" cwd[p] "\t" w "\t" t
      }
    }' "$work.attrs" > "$work.roll" 2>/dev/null

  awk -F'\t' -v rf="$work.roll" -v cf="$cache" '
    FILENAME == rf { r_cwd[$1]=$2; r_warn[$1]=$3; r_title[$1]=$4; fresh[$1]=1; next }
    FILENAME == cf { c_cwd[$2]=$5; c_warn[$2]=$6; c_title[$2]=$7; next }
    {
      p = $2
      if (p in fresh) print $1 "\t" p "\t" $3 "\t" $4 "\t" r_cwd[p] "\t" r_warn[p] "\t" r_title[p]
      else            print $1 "\t" p "\t" $3 "\t" $4 "\t" c_cwd[p] "\t" c_warn[p] "\t" c_title[p]
    }' "$work.roll" "$cache" "$work.now" 2>/dev/null \
    | sort -t"$(printf '\t')" -k3,3nr > "$work.next"

  if [ -s "$work.next" ]; then
    mv -f "$work.next" "$cache" 2>/dev/null
  fi
  rm -f "$work".*
  cat "$cache"
}

# session_id -> "session:window.pane" for sessions a live pane still holds.
#
# The active files outlive the panes that wrote them, so tmux is the authority:
# only panes present in this server get a label. Outside tmux there is nothing
# to check against, so nothing is labelled and nothing is blocked.
live_session_labels() {
  [ -n "${TMUX:-}" ] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  local line puuid target sid
  tmux list-panes -a -F '#{@claude-pane-id}|#{session_name}:#{window_index}.#{pane_index}' \
       2>/dev/null | while IFS= read -r line; do
    puuid="${line%%|*}"
    target="${line#*|}"
    [ -n "$puuid" ] || continue
    sid="$(read_active_session "$puuid")"
    [ -n "$sid" ] || continue
    printf '%s\t%s\n' "$sid" "$target"
  done
}

# Rows for the picker. Emits: session_id TAB live-label TAB display
# (live label is "-" when the session is not held by a pane, so the Enter
# binding can test the field without an empty-argument surprise).
pick_rows() {
  local scope="cwd" query="" state="" root slug idx work
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) state="${2:-}"; shift 2 ;;
      --scope) scope="${2:-cwd}"; shift 2 ;;
      *) query="$1"; shift ;;
    esac
  done
  [ -n "$state" ] && [ -f "$state" ] && scope="$(head -1 "$state" 2>/dev/null)"
  root="$(projects_root)"
  idx="$(session_index)"
  [ -n "$idx" ] || return 0

  if [ "$scope" = "cwd" ]; then
    slug="$(encode_cwd_for_projects "$PWD")"
    idx="$(printf '%s\n' "$idx" | awk -F'\t' -v s="/$slug/" 'index($2, s) > 0')"
  fi

  mkdir -p "$CLAUDE_RESCUE_CACHE_HOME" 2>/dev/null
  work="$CLAUDE_RESCUE_CACHE_HOME/.pick-work.$$"

  # Content search. Short queries match everything, so they are not worth a
  # pass over the corpus. Subagent hits fold into the session that owns them:
  # only <slug>/<sid>.jsonl can be resumed by name, and an orphaned
  # <slug>/subagents/... has no session to fold into.
  #
  # Matches are handed to awk through a FILE, never through -v: a -v value
  # cannot contain a literal newline (awk aborts with "newline in string").
  if [ ${#query} -ge 3 ]; then
    local scan="$root"
    [ "$scope" = "cwd" ] && scan="$root/$slug"
    rg -l --no-messages -i -F -g '*.jsonl' -- "$query" "$scan" 2>/dev/null \
      | awk -F'/' -v n="$(printf '%s' "$root" | awk -F'/' '{print NF}')" '
          { if (NF == n + 2) { s = $NF; sub(/\.jsonl$/, "", s); print s }
            else if (NF > n + 2 && $(n + 2) != "subagents") print $(n + 2) }' \
      | sort -u > "$work.hits" 2>/dev/null
    if [ ! -s "$work.hits" ]; then
      rm -f "$work".*
      return 0
    fi
    idx="$(printf '%s\n' "$idx" \
      | awk -F'\t' -v hf="$work.hits" 'FILENAME == hf { keep[$1] = 1; next } keep[$1]' \
            "$work.hits" -)"
  fi
  if [ -z "$idx" ]; then
    rm -f "$work".*
    return 0
  fi

  live_session_labels > "$work.live" 2>/dev/null
  printf '%s\n' "$idx" | awk -F'\t' \
      -v lf="$work.live" -v now="$(date +%s)" -v home="$HOME" '
    FILENAME == lf { if ($1 != "") L[$1] = $2; next }
    {
      sid = $1; mt = $3; cw = $5; wn = $6; ti = $7
      d = now - mt
      if      (d <    60) a = "now"
      else if (d <  3600) a = int(d /    60) "m"
      else if (d < 86400) a = int(d /  3600) "h"
      else                a = int(d / 86400) "d"
      # Same rule as tildify(), inline because a bash call per row costs more
      # than the whole render.
      if (index(cw, home) == 1) cw = "~" substr(cw, length(home) + 1)
      lbl = (sid in L) ? L[sid] : "-"
      if (ti == "") ti = "(untitled)"
      printf "%s\t%s\t%-4s %s %-58s %s%s\n", sid, lbl, a, (wn == "1" ? "!" : " "), ti, cw,
             (lbl == "-" ? "" : "  [live " lbl "]")
    }' "$work.live" -
  rm -f "$work".*
}

pick_header() {
  local state="${1:-}" scope="cwd" here
  [ -n "$state" ] && [ -f "$state" ] && scope="$(head -1 "$state" 2>/dev/null)"
  here="$(tildify "$PWD")"
  if [ "$scope" = "cwd" ]; then
    printf 'scope: %s   (tab: all projects)   ! = 200K downgrade' "$here"
  else
    printf 'scope: all projects   (tab: %s only)   ! = 200K downgrade' "$here"
  fi
}

pick_toggle() {
  local state="${1:-}" scope="cwd"
  [ -n "$state" ] || return 0
  [ -f "$state" ] && scope="$(head -1 "$state" 2>/dev/null)"
  if [ "$scope" = "cwd" ]; then printf 'all\n' > "$state"; else printf 'cwd\n' > "$state"; fi
}

pick_preview() {
  local sid="${1:-}" path row cwd model
  [ -n "$sid" ] || return 0
  path="$(transcript_for_session "$sid")"
  if [ -z "$path" ]; then echo "(no transcript on disk)"; return 0; fi
  row="$(session_index | awk -F'\t' -v s="$sid" '$1 == s { print; exit }')"
  cwd="$(printf '%s' "$row" | cut -f5)"
  model="$(session_model "$sid")"
  echo "session : $sid"
  echo "cwd     : $(tildify "$cwd")"
  [ -n "$model" ] && echo "resumes : $model"
  echo "size    : $(printf '%s' "$row" | cut -f4) bytes"
  echo "---"
  # The user's typed prompts are the plain-string user records; tool traffic
  # carries an array instead, so this shows what the human actually asked. The
  # whole file is scanned, not the tail: on a tool-heavy session every typed
  # prompt can sit in the first few percent of a multi-MB transcript.
  # {1,250}, not more: BSD grep refuses a bounded repeat above 255
  # ("maximum repetition exceeds 255") while GNU grep accepts it, so a larger
  # bound works on Linux and silently returns nothing on macOS.
  grep -oE '"role":"user","content":"[^"]{1,250}' "$path" 2>/dev/null \
    | sed -e 's/^.*content":"//' -e 's/\\n/ /g' -e 's/\\t/ /g' \
    | tail -n 6 \
    | cut -c1-300
}

# The picker. Prints the chosen session id, nothing when cancelled.
#
# fzf does no filtering of its own (--disabled): the query is a ripgrep search
# over transcript CONTENT, which is what makes a half-remembered phrase from
# inside a session findable, and rows stay in last-active order rather than
# being reordered by match score. Scope lives in a file because reload and
# transform-header actions run as separate processes and have to agree.
pick() {
  local query="${1:-}" state out self="$0"
  if ! command -v fzf >/dev/null 2>&1; then
    echo "claude-rescue pick: fzf not found" >&2
    return 2
  fi
  mkdir -p "$CLAUDE_RESCUE_CACHE_HOME" 2>/dev/null
  state="$CLAUDE_RESCUE_CACHE_HOME/.pick-scope.$$"
  printf 'cwd\n' > "$state"
  out="$("$self" pick-rows --state "$state" ${query:+"$query"} \
    | fzf --ansi --reverse --no-multi --disabled \
          --delimiter="$(printf '\t')" --with-nth=3.. \
          --prompt='search transcripts> ' \
          --query="$query" \
          --header="$("$self" pick-header "$state")" \
          --footer='enter resume · tab scope · ctrl-y copy id · esc cancel' \
          --preview "'$self' pick-preview {1}" \
          --preview-window=right:52%:wrap \
          --bind "change:reload('$self' pick-rows --state '$state' {q})" \
          --bind "tab:execute-silent('$self' pick-toggle '$state')+reload('$self' pick-rows --state '$state' {q})+transform-header('$self' pick-header '$state')" \
          --bind "ctrl-y:execute-silent('$self' pick-copy {1})" \
          --bind "enter:transform:if [ {2} = - ]; then echo accept; else echo 'change-header(this session is live in {2} — switch to that pane instead of resuming it twice)'; fi" \
    )"
  rm -f "$state"
  [ -n "$out" ] || return 0
  printf '%s' "$out" | cut -f1
}

# ---------------------------------------------------------------------------
# Entry — dispatch subcommands or pop the picker.

cmd="${1:-}"
case "$cmd" in
  find-sessions)      shift; find_sessions "$@" ;;
  print)              shift; print_capture "$@" ;;
  model)              shift; session_model "$@" ;;
  latest)             shift; latest_session "$@" ;;
  resume-dir)         shift; resume_dir_for_session "$@" ;;
  index)              session_index ;;
  pick)               shift; pick "$@" ;;
  pick-rows)          shift; pick_rows "$@" ;;
  pick-header)        shift; pick_header "$@" ;;
  pick-toggle)        shift; pick_toggle "$@" ;;
  pick-preview)       shift; pick_preview "$@" ;;
  pick-copy)          shift; action_copy_uuid "$@" ;;
  live-sessions)      live_session_labels ;;
  '')
    if [ -z "${TMUX:-}" ]; then
      echo "claude-rescue: not inside tmux — 'claude-rescue pick' prints a session id," >&2
      echo "               and 'clr' resumes one directly." >&2
      exit 1
    fi
    if [ -z "${CLAUDE_RESCUE_IN_POPUP:-}" ]; then
      # $TMUX_PANE can leak from a nested-tmux context (an outer server's
      # pane id ends up in this server's global env). Query tmux directly
      # for the active client's active pane — reliable regardless of how
      # claude-rescue was invoked.
      orig_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null)"
      [ -z "$orig_pane" ] && orig_pane="${TMUX_PANE:-}"
      exec tmux display-popup -E -h 80% -w 90% \
        env CLAUDE_RESCUE_IN_POPUP=1 \
            CLAUDE_RESCUE_CONFIG_HOME="$CLAUDE_RESCUE_CONFIG_HOME" \
            CLAUDE_RESCUE_DATA_HOME="$CLAUDE_RESCUE_DATA_HOME" \
            CLAUDE_RESCUE_CACHE_HOME="$CLAUDE_RESCUE_CACHE_HOME" \
            CLAUDE_RESCUE_ORIG_PANE="$orig_pane" \
            "$0"
    fi
    picked="$(pick)" || exit $?
    [ -n "$picked" ] || exit 0
    action_resume_here "$picked"
    ;;
  *)
    echo "unknown subcommand: $cmd" >&2
    exit 2
    ;;
esac

#!/usr/bin/env bash
# claude-rescue-purge-guard — archive a conversation a pane holds before Claude
# Code's cleanup deletes it, then close the pane.
#
# Claude Code deletes a transcript nobody has written to for cleanupPeriodDays
# (its settings.json; 30 when unset). A hard-hibernated pane never writes to its
# conversation, so a thread left asleep that long loses it: 19 panes did on
# 2026-11-16. Before that happens, the guard copies the transcript into the
# Session archive and has a fresh Claude write down what it alone knew.
#
#   run   Archive the oldest due conversation, if any. What the watcher starts
#         every CLAUDE_RESCUE_PURGE_GUARD_CHECK_S on the default server. One run
#         at a time (a lock).
#   due   The due conversations, oldest first:
#         session_id TAB pane_uuid TAB days since last write
#   archive <sid>    Archive one conversation now, whatever its age, and close
#                    the pane holding it, if one does.
#   summarize <sid>  Write summary.md again from the archive's copy (a better
#                    prompt, a newer model). The previous one is kept if it fails.
#
# Due: a hard-hibernated pane holds it (its marker, resolved the way its
# `clr <sid>` pre-fill is), its transcript is older than cleanupPeriodDays
# minus CLAUDE_RESCUE_PURGE_LEAD_DAYS (14), no live Claude Code holds it, and
# the archive has not already seen this exact transcript (meta.json's
# transcript_mtime).
#
# Summarize: a headless `claude -p` with a clean context reads the archived copy
# (never the conversation itself, which stays untouched and is deleted on
# schedule) and writes summary.md. Opus with 1M context at its default effort;
# --safe-mode (no CLAUDE.md, hooks, MCP, skills); --no-session-persistence
# (nothing of it is saved, so it is never archived itself); its tools limited to
# reading and to writing summary.md, its working directory the archive. On
# success the pane is closed: the thread is done, and its archive stays.
#
# API errors: a run that ends on one, instead of its notes, is run once more
# with CLAUDE_RESCUE_PURGE_FALLBACK (config.sh), if set: a command run in
# claude's place, with the same arguments but --model, so it brings its own
# model or backend. Off by default; meta.json's `fallback` lists the runs that
# used it.
#
# Long conversations: no run reads more than CLAUDE_RESCUE_PURGE_PART_CHARS
# (1.5M) rendered characters, ~400k tokens of Opus's 1M. A longer transcript is
# cut into parts at lines; one run per part writes part-K.md (the same sections,
# citing lines, with what each compaction summary and recap claims), and a last
# run merges them into summary.md, checking those claims across the parts.
#
# Archive: $CLAUDE_RESCUE_DATA_HOME/session-archive/<sid>/
#   transcript.jsonl   the transcript as found
#   session-files/     the conversation's own dir (subagents, tool results), if any
#   summary.md         the knowledge dump
#   part-K.md          a long conversation's notes, one per part
#   run.log            the summarizing runs' output
#   meta.json          sid, pane, folder, ages, status, timestamps
set -uo pipefail

__script="$0"
while [ -L "$__script" ]; do
  __link="$(readlink "$__script")"
  case "$__link" in
    /*) __script="$__link" ;;
    *)  __script="$(cd "$(dirname "$__script")" && pwd)/$__link" ;;
  esac
done
REPO="$(cd "$(dirname "$__script")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$REPO/lib/common.sh"

ARCHIVE_DIR="$CLAUDE_RESCUE_DATA_HOME/session-archive"
LEAD_DAYS="${CLAUDE_RESCUE_PURGE_LEAD_DAYS:-14}"
TIMEOUT_S="${CLAUDE_RESCUE_PURGE_TIMEOUT_S:-3600}"
# The most a summarizing run reads, as rendered characters (~4 per token): 1.5M
# leaves room in Opus's 1M context for paging, tool output and its own notes.
PART_CHARS="${CLAUDE_RESCUE_PURGE_PART_CHARS:-1500000}"
CLAUDE_CMD="${CLAUDE_RESCUE_PURGE_CLAUDE:-claude}"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

mtime_of() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

cleanup_days() {
  local d
  d="$(jq -r '.cleanupPeriodDays // empty' "$CLAUDE_HOME/settings.json" 2>/dev/null)"
  case "$d" in ''|*[!0-9]*) d=30 ;; esac
  printf '%s\n' "$d"
}

# Session ids a live Claude Code process holds: its record in sessions/<pid>.json
# names the session, and the pid must still be claude (or node, an npm install).
live_sessions() {
  local f pid sid comm
  for f in "$CLAUDE_HOME"/sessions/*.json; do
    [ -f "$f" ] || continue
    pid="$(jq -r '.pid // empty' "$f" 2>/dev/null)"
    sid="$(jq -r '.sessionId // empty' "$f" 2>/dev/null)"
    [ -n "$pid" ] && [ -n "$sid" ] || continue
    comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
    case "${comm##*/}" in claude|node) printf '%s\n' "$sid" ;; esac
  done
}

cmd_due() {
  local threshold now live pane_uuid sid path age seen=" " meta last
  threshold=$(( $(cleanup_days) - LEAD_DAYS ))
  [ "$threshold" -ge 1 ] || threshold=1
  now="$(date +%s)"
  live="$(live_sessions)"
  tmux list-panes -aF '#{@claude-pane-id}' 2>/dev/null | while IFS= read -r pane_uuid; do
    [ -n "$pane_uuid" ] || continue
    [ "$(hibernated_marker_field "$pane_uuid" mode)" = "hard" ] || continue
    sid="$(resolve_resume_session_id "$pane_uuid")"
    [ -n "$sid" ] || sid="$(read_active_session "$pane_uuid" 2>/dev/null || true)"
    [[ "$sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || continue
    case "$seen" in *" $sid "*) continue ;; esac
    seen+="$sid "
    path="$(transcript_for_session "$sid")"
    [ -n "$path" ] || continue
    age=$(( (now - $(mtime_of "$path")) / 86400 ))
    [ "$age" -ge "$threshold" ] || continue
    printf '%s\n' "$live" | grep -qxF "$sid" && continue
    meta="$ARCHIVE_DIR/$sid/meta.json"
    if [ -f "$meta" ]; then
      last="$(jq -r '.transcript_mtime // empty' "$meta" 2>/dev/null)"
      [ "$last" = "$(mtime_of "$path")" ] && continue
    fi
    printf '%s\t%s\t%s\n' "$sid" "$pane_uuid" "$age"
  done | sort -t $'\t' -k3,3nr
}

# meta.json update: jq filter + args, applied in place.
meta_set() {
  local meta="$1"; shift
  jq "$@" "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
}

# The summarizer's prompts. One run reads the whole conversation and writes
# summary.md; a conversation too long for one context is read in parts, each
# run writing part-K.md, and a last run merges them. The text is shared.
prompt_intro() {
  cat <<'PROMPT'
You are archiving a Claude Code conversation that is about to be deleted. It sat untouched for months, and Claude Code removes such conversations. The code, the commits, the PRs and the tickets keep the outcomes of the work. What usually exists only in the conversation is everything else: the details, the open items, and the contradictions. Your job is to find those and write them down, so whoever picks this thread up later (a person, or another Claude session with no access to it) loses nothing that mattered.
PROMPT
}

prompt_have() { # $1: with the session-files line (yes), or without
  cat <<'PROMPT'
## What you have (read-only copies, in the current directory)

- `transcript.jsonl`: the whole conversation, one JSON object per line, oldest first. Messages have `type` "user" or "assistant"; `message.content` is a string or a list of blocks: `text` (what was said), `thinking`, `tool_use` (the tool and its input: commands run, files edited) and `tool_result` (their output). Other line types carry little or no content.
- Compactions: when the context filled up, Claude Code wrote a summary of everything so far and the conversation carried on from that summary. The summary is a "user" line with `"isCompactSummary": true`, right after a "system" line with `"subtype": "compact_boundary"`. Nothing before a compaction was deleted: the full earlier history is still in the file. Read both. The summary is what the conversation believed it knew from then on; the history is what actually happened. Details a summary dropped are exactly what to recover, and where the two disagree, that is a contradiction to report.
- Summarized messages of other kinds count too: recaps Claude gave the user, TLDRs, status reports, handoff notes. Check them against the history the same way.
PROMPT
  [ "${1:-yes}" = yes ] && cat <<'PROMPT'
- `session-files/` (if present): the conversation's subagents (`subagents/agent-*.jsonl`, same format) and saved tool results. Read what the subagents found and reported back.
PROMPT
  cat <<'PROMPT'
- `render.jq`: renders a range of lines as readable text. Messages in full; tool calls, tool results and thinking clipped to 1,500 characters; compactions marked.
PROMPT
}

prompt_sections() {
  cat <<'PROMPT'
Markdown, with these sections, in this order:

1. **Overview**: what the conversation was about and for whom; when (dates, from the timestamps); the folders, repos and branches it worked in; and how it ended (done, abandoned, waiting on something, cut off).
2. **Open items**: everything left unresolved. Unfinished work; to-dos; follow-ups either side promised; questions asked and never answered (by the user or by Claude); things waiting on someone or something; claims never verified; plans never carried out; work left uncommitted, unpushed or unmerged; anything said to be done "later". For each: what it is, what was known about it, and the next step. Be exhaustive: this is the most valuable section.
3. **Contradictions**: places where the conversation contradicts itself. Claims later corrected; the user correcting Claude; Claude's statements that the history contradicts; a compaction summary or recap that disagrees with what happened, or drops something that mattered; requirements or plans that changed; assumptions that proved wrong; findings that conflict. For each: both versions, when, and which one stood at the end, or that it was never settled.
4. **Details**: the specifics that would be hard to find again. Exact commands, file paths, branches, commit SHAs, PR and ticket numbers, error messages, config values, numbers, URLs, names. Quote them exactly; never paraphrase an identifier.
5. **Decisions**: each decision, why, who made it (the user or Claude), and the alternatives rejected.
6. **Knowledge**: what was learned that is worth keeping on its own: how a system really behaves, gotchas, workarounds, and the user's preferences and corrections to how Claude works.
7. **Timeline**: what happened, in order, with dates. Brief.
PROMPT
}

prompt_rules() { # $1 the file to write, $2 the one-line reply
  cat <<'PROMPT'
## Rules

- Use only these files. Don't look up the current state of repos, PRs or tickets: the point is what this conversation knew.
- Say who said what when it matters: "the user asked", "Claude claimed".
- Never invent. Mark anything uncertain as uncertain. A section with nothing in it says "None found."
- Completeness over brevity in Open items, Contradictions and Details.
PROMPT
  printf -- '- Write `%s` once, at the end, with the Write tool. Then reply with one line: %s\n' "$1" "$2"
}

# The whole conversation in one run.
summary_prompt() {
  prompt_intro; echo; prompt_have yes; echo
  cat <<'PROMPT'
## How to read it

Read all of it, start to end, in order, including the middle. Not a sample, and not only the beginning and the end. Page through it:

    wc -l transcript.jsonl
    jq -r --argjson from 1 --argjson to 300 -f render.jq transcript.jsonl
    jq -r --argjson from 301 --argjson to 600 -f render.jq transcript.jsonl
    ...

Use smaller ranges if a page is too long. To read one line whole (a clipped tool result that matters): `jq -c 'select(input_line_number == N)' transcript.jsonl`. Subagent files render the same way: `jq -r --argjson from 1 --argjson to 300 -f render.jq session-files/subagents/agent-XXXX.jsonl`.

## What to write: `summary.md`, in this directory

PROMPT
  prompt_sections; echo; prompt_rules summary.md Archived.
}

# Part $1 of $2: transcript lines $3..$4, notes to part-$1.md.
part_prompt() {
  local k=$1 n=$2 from=$3 to=$4
  prompt_intro; echo
  printf 'This conversation is too long to read in one sitting, so it is read in %s parts, in order, each by a fresh session like you, and a last session merges what the parts found into the summary. You read part %s of %s: lines %s to %s of `transcript.jsonl`.\n\n' "$n" "$k" "$n" "$from" "$to"
  prompt_have no; echo
  cat <<'PROMPT'
## How to read it

Read all of your lines, start to end, in order, including the middle. Not a sample. Page through them a few hundred lines at a time, for example:

PROMPT
  printf '    jq -r --argjson from %s --argjson to %s -f render.jq transcript.jsonl\n\n' "$from" "$(( from + 299 < to ? from + 299 : to ))"
  cat <<'PROMPT'
Use smaller ranges if a page is too long. To read one line whole (a clipped tool result that matters): `jq -c 'select(input_line_number == N)' transcript.jsonl`. The other lines are other parts: read one only when a message in your part points back to it. The subagents in `session-files/` are read by the last session, not you.

PROMPT
  printf '## What to write: `part-%s.md`, in this directory\n\n' "$k"
  printf 'Start it with the line `Part %s of %s: lines %s to %s.` ' "$k" "$n" "$from" "$to"
  cat <<'PROMPT'
Then your notes for the last session, on your part only. Cite the line number (#N) of everything you record, so it can find it. Record every compaction summary and recap in your part with what it claims, and say what the conversation believed at the end of your part (state, plans, open items): the last session checks them against the other parts.

PROMPT
  prompt_sections; echo; prompt_rules "part-$k.md" Done.
}

# The merge of $1 parts' notes into summary.md.
merge_prompt() {
  local n=$1
  prompt_intro; echo
  printf 'It was too long to read in one sitting, so %s sessions read it in parts, in order, and each wrote its notes: `part-1.md` to `part-%s.md` (each names the lines it covers, and cites them). You write the summary from those notes.\n\n' "$n" "$n"
  prompt_have yes; echo
  cat <<'PROMPT'
## How to work

Read every part's notes, in order. Merge them: one item per thing, not per part. An open item a later part closes is not open; say where it was closed. Check each compaction summary and recap the notes record against what the earlier parts say happened: where they disagree, or a summary dropped something that mattered, that is a contradiction. Where the notes are unclear or disagree, read the lines they cite: `jq -r --argjson from N --argjson to M -f render.jq transcript.jsonl`. Read the subagents in `session-files/` yourself, if present: `jq -r --argjson from 1 --argjson to 300 -f render.jq session-files/subagents/agent-XXXX.jsonl`.

## What to write: `summary.md`, in this directory

PROMPT
  prompt_sections; echo; prompt_rules summary.md Archived.
}

# Close the pane that held the conversation, if it still does: hard-hibernated,
# at a shell, on this conversation. The watcher sees it go and clears its marker.
close_pane() {
  local pane_uuid="$1" sid="$2" pane cur held
  pane="$(tmux list-panes -aF $'#{@claude-pane-id}\t#{pane_id}' 2>/dev/null \
            | awk -F'\t' -v u="$pane_uuid" '$1==u {print $2; exit}')"
  [ -n "$pane" ] || return 1
  [ "$(hibernated_marker_field "$pane_uuid" mode)" = "hard" ] || return 1
  cur="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null)"
  is_shell_cmd "$cur" || return 1
  held="$(resolve_resume_session_id "$pane_uuid")"
  [ -n "$held" ] || held="$(read_active_session "$pane_uuid" 2>/dev/null || true)"
  [ "$held" = "$sid" ] || return 1
  tmux kill-pane -t "$pane" 2>/dev/null
}

# The parts a transcript is read in: "from to" line ranges, each rendered (what
# the summarizer reads, by render.jq) to no more than PART_CHARS, cut between
# lines. One part is the whole conversation.
parts_of() { # $1 render.jq, $2 transcript
  local last
  last="$(wc -l < "$2" | tr -d ' ')"
  jq -r --argjson from 1 --argjson to "$last" -f "$1" "$2" 2>/dev/null \
    | awk -v max="$PART_CHARS" -v last="$last" '
        BEGIN { from = 1 }
        /^#[0-9]+ / { n = substr($1, 2) + 0; if (size >= max && n > from) { print from, n - 1; from = n; size = 0 } }
        { size += length($0) + 1 }
        END { print from, last }'
}

# One headless claude in the archive: prompt $3, allowed to write only $2.
# Its exit status; stopped after TIMEOUT_S. Output appended to run.log. With
# $4, the fallback (CLAUDE_RESCUE_PURGE_FALLBACK) runs in claude's place, given
# the same arguments but --model: it picks its own.
run_summarizer() {
  local dir="$1" out="$2" prompt="$3" fallback="${4:-}" pid started
  printf '=== %s %s%s\n' "$(now_iso)" "$out" "${fallback:+ (fallback)}" >> "$dir/run.log"
  (
    cd "$dir" || exit 1
    if [ -n "$fallback" ]; then set -- "$fallback"; else set -- "$CLAUDE_CMD" --model 'opus[1m]'; fi
    exec "$@" -p --safe-mode --no-session-persistence \
      --tools "Read Grep Glob Write Bash" \
      --allowedTools "Read Grep Glob Edit(./$out) Bash(jq *) Bash(wc *) Bash(head *) Bash(tail *) Bash(ls *)" \
      --permission-mode dontAsk "$prompt"
  ) </dev/null >> "$dir/run.log" 2>&1 &
  pid=$!
  started="$(date +%s)"
  while kill -0 "$pid" 2>/dev/null; do
    if [ $(( $(date +%s) - started )) -ge "$TIMEOUT_S" ]; then
      kill "$pid" 2>/dev/null
      log_err "purge-guard: $(basename "$dir"): no $out after ${TIMEOUT_S}s; stopped"
      break
    fi
    sleep 5
  done
  wait "$pid" 2>/dev/null
}

# The fallback is opted into (config.sh), and is there to run.
fallback_ready() {
  [ -n "${CLAUDE_RESCUE_PURGE_FALLBACK:-}" ] && [ -x "$CLAUDE_RESCUE_PURGE_FALLBACK" ]
}

# One summarizing run that has to write $2. When it ends on an API error (the
# one claude prints, in this run's part of run.log) and the fallback is opted
# into, it runs once more on the fallback. Any other failure is not retried.
# 0 when $2 was written; FALLBACK_USED lists what fell back.
FALLBACK_USED=""
run_one() {
  local dir="$1" out="$2" prompt="$3" rc=0 mark
  mark="$(wc -c < "$dir/run.log" 2>/dev/null | tr -d ' ')"
  run_summarizer "$dir" "$out" "$prompt" || rc=$?
  [ -s "$dir/$out" ] && return 0
  if fallback_ready \
     && tail -c +$(( ${mark:-0} + 1 )) "$dir/run.log" | grep -q '^API Error'; then
    log_err "purge-guard: $(basename "$dir"): $out ended on an API error; again with the fallback"
    FALLBACK_USED="$FALLBACK_USED $out"
    rc=0
    run_summarizer "$dir" "$out" "$prompt" "$CLAUDE_RESCUE_PURGE_FALLBACK" || rc=$?
    [ -s "$dir/$out" ] && return 0
  fi
  [ "$rc" -ne 0 ] || rc=1
  return "$rc"
}

# The summarizing run over the archive's copy: fresh, headless claudes write
# summary.md. A conversation whose rendering fits PART_CHARS is read by one; a
# longer one is read in parts, each writing part-K.md, and a last run merges
# them, so no run holds more than a part. 0 when summary.md was written;
# meta.json says how it went either way.
summarize_archive() {
  local sid="$1" dir="$ARCHIVE_DIR/$1" rc=0 parts n k=0 from to
  local meta="$dir/meta.json"
  [ -s "$dir/transcript.jsonl" ] && [ -f "$meta" ] || { echo "no archive for $sid" >&2; return 1; }
  meta_set "$meta" --arg ts "$(now_iso)" '.status="summarizing" | .summarize_started_at=$ts'
  cp "$REPO/lib/transcript-render.jq" "$dir/render.jq"
  [ -f "$dir/summary.md" ] && mv "$dir/summary.md" "$dir/summary.previous.md"
  rm -f "$dir"/part-*.md "$dir/run.log"
  parts="$(parts_of "$dir/render.jq" "$dir/transcript.jsonl")"
  n="$(printf '%s\n' "$parts" | grep -c .)"
  FALLBACK_USED=""
  if [ "$n" -le 1 ]; then
    run_one "$dir" summary.md "$(summary_prompt)" || rc=$?
  else
    log_err "purge-guard: $sid: too long for one run; reading it in $n parts"
    while read -r from to; do
      k=$((k + 1))
      run_one "$dir" "part-$k.md" "$(part_prompt "$k" "$n" "$from" "$to")" || { rc=$?; break; }
    done <<<"$parts"
    [ "$rc" -eq 0 ] && { run_one "$dir" summary.md "$(merge_prompt "$n")" || rc=$?; }
  fi
  meta_set "$meta" --arg f "$FALLBACK_USED" '.fallback = ($f | split(" ") | map(select(. != "")))'
  rm -f "$dir/render.jq"
  if [ ! -s "$dir/summary.md" ]; then
    [ -f "$dir/summary.previous.md" ] && mv "$dir/summary.previous.md" "$dir/summary.md"
    meta_set "$meta" --arg ts "$(now_iso)" --argjson rc "$rc" --argjson n "$n" \
      '.status="failed" | .ended_at=$ts | .exit=$rc | .parts=$n'
    log_err "purge-guard: $sid: no summary (exit $rc); see $dir/run.log"
    return 1
  fi
  rm -f "$dir/summary.previous.md"
  meta_set "$meta" --arg ts "$(now_iso)" --argjson n "$n" '.status="archived" | .archived_at=$ts | .parts=$n'
}

# Copy a conversation into the archive, summarize it, and close the pane that
# held it ($2, may be empty). The copy comes first: whatever happens to the
# summary, nothing is lost.
archive_conversation() {
  local sid="$1" pane_uuid="${2:-}" age="${3:-0}" path dir meta cwd
  path="$(transcript_for_session "$sid")"
  [ -n "$path" ] || { echo "no transcript for $sid" >&2; return 1; }
  dir="$ARCHIVE_DIR/$sid"
  meta="$dir/meta.json"
  mkdir -p "$dir"
  cp -p "$path" "$dir/transcript.jsonl" || { log_err "purge-guard: copy of $path failed"; return 1; }
  rm -rf "$dir/session-files"
  [ -d "${path%.jsonl}" ] && cp -Rp "${path%.jsonl}" "$dir/session-files"
  cwd="$("$REPO/bin/claude-rescue" resume-dir "$sid" 2>/dev/null)"
  jq -n --arg sid "$sid" --arg pu "$pane_uuid" --arg tr "$path" --arg cwd "$cwd" \
        --argjson age "$age" --arg ts "$(now_iso)" --arg mt "$(mtime_of "$path")" \
     '{session_id:$sid, pane_uuid:$pu, transcript:$tr, cwd:$cwd, age_days:$age,
       copied_at:$ts, transcript_mtime:$mt, status:"copied"}' > "$meta"
  log_err "purge-guard: $sid (pane ${pane_uuid:-none}, ${age}d) copied to $dir"
  summarize_archive "$sid" || return 1
  if [ -n "$pane_uuid" ] && close_pane "$pane_uuid" "$sid"; then
    meta_set "$meta" '.pane_closed=true'
    log_err "purge-guard: $sid archived; its pane closed"
  else
    meta_set "$meta" '.pane_closed=false'
    log_err "purge-guard: $sid archived; no pane holding it was closed"
  fi
}

# The pane holding a conversation, by the same resolution as `due`. Empty if none.
pane_holding() {
  local sid="$1" pane_uuid held
  tmux list-panes -aF '#{@claude-pane-id}' 2>/dev/null | while IFS= read -r pane_uuid; do
    [ -n "$pane_uuid" ] || continue
    [ "$(hibernated_marker_field "$pane_uuid" mode)" = "hard" ] || continue
    held="$(resolve_resume_session_id "$pane_uuid")"
    [ -n "$held" ] || held="$(read_active_session "$pane_uuid" 2>/dev/null || true)"
    [ "$held" = "$sid" ] && { printf '%s\n' "$pane_uuid"; break; }
  done
}

# One run at a time, across run, archive and summarize.
take_lock() {
  local lock="$ARCHIVE_DIR/.lock"
  mkdir -p "$ARCHIVE_DIR"
  if ! mkdir "$lock" 2>/dev/null; then
    # A run is going, or one died holding the lock: take over only from a dead one.
    kill -0 "$(cat "$lock/pid" 2>/dev/null || echo 0)" 2>/dev/null && return 1
    rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 1
  fi
  echo $$ > "$lock/pid"
  # Expanded now: the trap fires after the caller's locals are gone.
  trap "rm -rf '$lock'" EXIT
}

valid_sid() {
  [[ "${1:-}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
    || { echo "not a session id: ${1:-}" >&2; return 2; }
}

cmd_run() {
  local row sid pane_uuid age
  take_lock || return 0
  row="$(cmd_due | head -n 1)"
  [ -n "$row" ] || return 0
  IFS=$'\t' read -r sid pane_uuid age <<<"$row"
  archive_conversation "$sid" "$pane_uuid" "$age"
}

cmd_archive() {
  local sid="${1:-}" path
  valid_sid "$sid" || return 2
  take_lock || { echo "another archive run is going" >&2; return 1; }
  path="$(transcript_for_session "$sid")"
  [ -n "$path" ] || { echo "no transcript for $sid" >&2; return 1; }
  archive_conversation "$sid" "$(pane_holding "$sid")" $(( ($(date +%s) - $(mtime_of "$path")) / 86400 ))
}

cmd_summarize() {
  local sid="${1:-}"
  valid_sid "$sid" || return 2
  take_lock || { echo "another archive run is going" >&2; return 1; }
  summarize_archive "$sid"
}

case "${1:-}" in
  run)       shift; cmd_run "$@" ;;
  due)       shift; cmd_due "$@" ;;
  archive)   shift; cmd_archive "$@" ;;
  summarize) shift; cmd_summarize "$@" ;;
  *) echo "usage: claude-rescue-purge-guard run | due | archive <sid> | summarize <sid>" >&2; exit 2 ;;
esac

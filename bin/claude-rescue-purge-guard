#!/usr/bin/env bash
# claude-rescue-purge-guard — archive a conversation a pane holds before Claude
# Code's cleanup deletes it.
#
# Claude Code deletes a transcript nobody has written to for cleanupPeriodDays
# (its settings.json; 30 when unset). A hard-hibernated pane never writes to its
# conversation, so a thread left asleep that long loses it: 19 panes did on
# 2026-11-16. Before that happens, the guard copies the transcript into the
# Session archive and has Claude write down what the conversation knows.
#
#   run              Archive the oldest due conversation, if any. What the
#                    watcher starts every CLAUDE_RESCUE_PURGE_GUARD_CHECK_S on the
#                    default server. One run at a time (a lock).
#   due              The due conversations, oldest first:
#                    session_id TAB pane_uuid TAB days since last write
#   summarize <sid> <archive_dir>
#                    Typed into the archive window by `run`: execs claude on the
#                    conversation with the summary prompt.
#
# Due: a hard-hibernated pane holds it (its marker, resolved the way its
# `clr <sid>` pre-fill is), its transcript is older than cleanupPeriodDays
# minus CLAUDE_RESCUE_PURGE_LEAD_DAYS (14), no live Claude Code holds it, and
# the archive has not already seen this exact transcript (meta.json's
# transcript_mtime: an archived or stalled conversation waits until it changes).
#
# Summarize: the conversation is resumed in place, in a window of tmux session
# `rescue-archive`, on Opus with 1M context at its default effort. The summary
# turn writes to the transcript, which restarts its cleanup clock once; meta.json
# records the transcript as it was left, so the next check does not archive it
# again, and the cleanup then deletes it with the archive kept. When summary.md
# is written, claude exits and the window closes. A run that fails or stalls
# leaves its window open to jump into.
#
# Archive: $CLAUDE_RESCUE_DATA_HOME/session-archive/<sid>/
#   transcript.jsonl   the transcript as found, before the summary turn
#   session-files/     the conversation's own dir (subagents, tool results), if any
#   summary.md         Claude's knowledge dump
#   meta.json          sid, pane, folder, ages, status, timestamps
set -uo pipefail

__script="$0"
while [ -L "$__script" ]; do
  __link="$(readlink "$__script")"
  case "$__link" in
    /*) __script="$__link" ;;
    *)  __script="$(cd "$(dirname "$__script")" && pwd)/$__link" ;;
  esac
done
REPO="$(cd "$(dirname "$__script")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$REPO/lib/common.sh"

ARCHIVE_DIR="$CLAUDE_RESCUE_DATA_HOME/session-archive"
ARCHIVE_SESSION="rescue-archive"
LEAD_DAYS="${CLAUDE_RESCUE_PURGE_LEAD_DAYS:-14}"
TIMEOUT_S="${CLAUDE_RESCUE_PURGE_TIMEOUT_S:-3600}"
POLL_S="${CLAUDE_RESCUE_PURGE_POLL_S:-10}"
SETTLE_S="${CLAUDE_RESCUE_PURGE_SETTLE_S:-20}"
CLAUDE_CMD="${CLAUDE_RESCUE_PURGE_CLAUDE:-claude}"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

mtime_of() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

cleanup_days() {
  local d
  d="$(jq -r '.cleanupPeriodDays // empty' "$CLAUDE_HOME/settings.json" 2>/dev/null)"
  case "$d" in ''|*[!0-9]*) d=30 ;; esac
  printf '%s\n' "$d"
}

# Session ids a live Claude Code process holds: its record in sessions/<pid>.json
# names the session, and the pid must still be claude (or node, an npm install).
live_sessions() {
  local f pid sid comm
  for f in "$CLAUDE_HOME"/sessions/*.json; do
    [ -f "$f" ] || continue
    pid="$(jq -r '.pid // empty' "$f" 2>/dev/null)"
    sid="$(jq -r '.sessionId // empty' "$f" 2>/dev/null)"
    [ -n "$pid" ] && [ -n "$sid" ] || continue
    comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
    case "${comm##*/}" in claude|node) printf '%s\n' "$sid" ;; esac
  done
}

cmd_due() {
  local threshold now live pane_uuid sid path age seen=" " meta last
  threshold=$(( $(cleanup_days) - LEAD_DAYS ))
  [ "$threshold" -ge 1 ] || threshold=1
  now="$(date +%s)"
  live="$(live_sessions)"
  tmux list-panes -aF '#{@claude-pane-id}' 2>/dev/null | while IFS= read -r pane_uuid; do
    [ -n "$pane_uuid" ] || continue
    [ "$(hibernated_marker_field "$pane_uuid" mode)" = "hard" ] || continue
    sid="$(resolve_resume_session_id "$pane_uuid")"
    [ -n "$sid" ] || sid="$(read_active_session "$pane_uuid" 2>/dev/null || true)"
    [[ "$sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || continue
    case "$seen" in *" $sid "*) continue ;; esac
    seen+="$sid "
    path="$(transcript_for_session "$sid")"
    [ -n "$path" ] || continue
    age=$(( (now - $(mtime_of "$path")) / 86400 ))
    [ "$age" -ge "$threshold" ] || continue
    printf '%s\n' "$live" | grep -qxF "$sid" && continue
    meta="$ARCHIVE_DIR/$sid/meta.json"
    if [ -f "$meta" ]; then
      last="$(jq -r '.transcript_mtime // empty' "$meta" 2>/dev/null)"
      [ "$last" = "$(mtime_of "$path")" ] && continue
    fi
    printf '%s\t%s\t%s\n' "$sid" "$pane_uuid" "$age"
  done | sort -t $'\t' -k3,3nr
}

# meta.json update: jq filter + args, applied in place.
meta_set() {
  local meta="$1"; shift
  local tmp="$meta.tmp"
  jq "$@" "$meta" > "$tmp" && mv "$tmp" "$meta"
}

summary_prompt() {
  local dir="$1"
  cat <<EOF
This conversation is about to be deleted: Claude Code removes a conversation nobody has touched for its cleanup period, and this one has been asleep in a tmux pane that long. Before it goes, write down everything worth keeping from it, for whoever picks this thread up later (a person, or another Claude session with no access to this conversation).

Write it to $dir/summary.md with the Write tool, in one go, as your last step. Markdown, with these sections:

- **Goal**: what this conversation set out to do, and for whom.
- **What happened**: the work done, in order, briefly.
- **Decisions**: each decision taken and why, including approaches rejected.
- **State**: where things were left: what is done, what is in progress, uncommitted or unpushed work, open PRs, branches, worktrees.
- **Open loops**: what was still to do, waiting on someone, or unanswered.
- **Knowledge**: facts, gotchas, commands, and things learned that are worth keeping on their own.
- **References**: files, repos, branches, PRs, tickets, links, and people involved.

Write it from this conversation only. Don't run commands or read files to refresh it: the point is what this conversation knew. When the file is written, reply with one line: Archived.
EOF
}

cmd_summarize() {
  local sid="${1:?sid}" dir="${2:?archive dir}"
  # exec: claude must be the pane shell's own child, like any resumed pane.
  exec "$CLAUDE_CMD" -r "$sid" --model 'opus[1m]' --add-dir "$dir" \
    --permission-mode bypassPermissions "$(summary_prompt "$dir")"
}

# The archive window's claude still running: something other than the pane's
# shell holds its foreground (claude, or a tool claude runs).
pane_claude_alive() {
  local cur
  cur="$(tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null)" || return 1
  [ -n "$cur" ] && ! is_shell_cmd "$cur"
}

cmd_run() {
  local lock="$ARCHIVE_DIR/.lock" row sid pane_uuid age path dir meta cwd pane started
  mkdir -p "$ARCHIVE_DIR"
  if ! mkdir "$lock" 2>/dev/null; then
    # A run is going, or one died holding the lock: take over only from a dead one.
    kill -0 "$(cat "$lock/pid" 2>/dev/null || echo 0)" 2>/dev/null && return 0
    rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 0
  fi
  echo $$ > "$lock/pid"
  # Expanded now: the trap fires after this function's locals are gone.
  trap "rm -rf '$lock'" EXIT

  row="$(cmd_due | head -n 1)"
  [ -n "$row" ] || return 0
  IFS=$'\t' read -r sid pane_uuid age <<<"$row"
  path="$(transcript_for_session "$sid")"
  [ -n "$path" ] || return 0
  dir="$ARCHIVE_DIR/$sid"
  meta="$dir/meta.json"
  mkdir -p "$dir"

  # The copy first: whatever happens to the summary, nothing is lost.
  cp -p "$path" "$dir/transcript.jsonl" || { log_err "purge-guard: copy of $path failed"; return 1; }
  [ -d "${path%.jsonl}" ] && cp -Rp "${path%.jsonl}" "$dir/session-files"
  cwd="$("$REPO/bin/claude-rescue" resume-dir "$sid" 2>/dev/null)"
  jq -n --arg sid "$sid" --arg pu "$pane_uuid" --arg tr "$path" --arg cwd "$cwd" \
        --argjson age "$age" --arg ts "$(now_iso)" --arg mt "$(mtime_of "$path")" \
     '{session_id:$sid, pane_uuid:$pu, transcript:$tr, cwd:$cwd, age_days:$age,
       copied_at:$ts, transcript_mtime:$mt, status:"copied"}' > "$meta"
  log_err "purge-guard: $sid (pane $pane_uuid, ${age}d) copied to $dir"

  if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
    meta_set "$meta" '.status="no-resume-dir"'
    log_err "purge-guard: $sid has no folder to resume in; copy only"
    return 0
  fi

  tmux has-session -t "=$ARCHIVE_SESSION" 2>/dev/null \
    || tmux new-session -d -s "$ARCHIVE_SESSION" -c "$HOME" 2>/dev/null
  local -a env_args=()
  [ -n "${CLAUDE_RESCUE_PURGE_CLAUDE:-}" ] && env_args=(-e "CLAUDE_RESCUE_PURGE_CLAUDE=$CLAUDE_RESCUE_PURGE_CLAUDE")
  pane="$(tmux new-window -d ${env_args[@]+"${env_args[@]}"} -t "$ARCHIVE_SESSION:" -n "archive-${sid:0:8}" -c "$cwd" \
            -P -F '#{pane_id}' 2>/dev/null)" || { meta_set "$meta" '.status="no-window"'; return 1; }
  # Typed into the window's shell, not run as its command: claude must be the
  # pane shell's own child, or tmux-resurrect saves the wrapper and a restart
  # loses the run.
  tmux send-keys -t "$pane" "$(printf '%q ' "$REPO/bin/claude-rescue-purge-guard" summarize "$sid" "$dir")" Enter
  meta_set "$meta" --arg p "$pane" --arg ts "$(now_iso)" '.status="summarizing" | .pane_id=$p | .started_at=$ts'

  started="$(date +%s)"
  local summary="$dir/summary.md" seen_claude=no
  while :; do
    sleep "$POLL_S"
    if [ -s "$summary" ] && [ $(( $(date +%s) - $(mtime_of "$summary") )) -ge "$SETTLE_S" ]; then
      break
    fi
    if pane_claude_alive "$pane"; then
      seen_claude=yes
    elif [ "$seen_claude" = yes ] || [ $(( $(date +%s) - started )) -ge 120 ]; then
      # claude ended (or never started) without writing the summary.
      meta_set "$meta" --arg ts "$(now_iso)" '.status="failed" | .ended_at=$ts'
      log_err "purge-guard: $sid: claude ended without a summary; window $pane left open"
      return 1
    fi
    if [ $(( $(date +%s) - started )) -ge "$TIMEOUT_S" ]; then
      meta_set "$meta" --arg ts "$(now_iso)" '.status="stalled" | .ended_at=$ts'
      log_err "purge-guard: $sid: no summary after ${TIMEOUT_S}s; window $pane left open"
      return 1
    fi
  done

  # Plain text and a separate Enter: claude's extended-keys mode garbles control
  # keys sent with it.
  tmux send-keys -t "$pane" "/exit"
  sleep 1
  tmux send-keys -t "$pane" Enter
  local _
  for _ in $(seq 1 30); do pane_claude_alive "$pane" || break; sleep 1; done
  meta_set "$meta" --arg ts "$(now_iso)" --arg mt "$(mtime_of "$path")" \
    '.status="archived" | .archived_at=$ts | .transcript_mtime=$mt'
  pane_claude_alive "$pane" || tmux kill-window -t "$pane" 2>/dev/null
  log_err "purge-guard: $sid archived"
}

case "${1:-}" in
  run)       shift; cmd_run "$@" ;;
  due)       shift; cmd_due "$@" ;;
  summarize) shift; cmd_summarize "$@" ;;
  *) echo "usage: claude-rescue-purge-guard run|due|summarize <sid> <dir>" >&2; exit 2 ;;
esac

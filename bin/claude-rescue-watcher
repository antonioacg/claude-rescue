#!/usr/bin/env bash
# claude-rescue-watcher — launch the native per-tmux-server Watcher Adapter.
#
# Keep this shell seam so the existing config.sh contract remains intact. The
# long-running loop execs into Python; no shell polling or per-pane subprocess
# fan-out remains here.

set -uo pipefail

__script="$0"
while [ -L "$__script" ]; do
  __link="$(readlink "$__script")"
  case "$__link" in
    /*) __script="$__link" ;;
    *)  __script="$(cd "$(dirname "$__script")" && pwd)/$__link" ;;
  esac
done
REPO="$(cd "$(dirname "$__script")/.." && pwd)"

# common.sh sources the user config. Export its assignments so the Python
# Adapter receives the same paths and tuning knobs as the former Bash daemon.
set -a
# shellcheck source=../lib/common.sh
. "$REPO/lib/common.sh"
set +a

exec "$REPO/bin/claude-rescue-state" watch --repository "$REPO"
